<UserControl x:Class="Hbpos.Client.Wpf.Views.CardRecoveryCenterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:loc="clr-namespace:Hbpos.Client.Wpf.Localization"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="688"
             d:DesignWidth="1366"
             Background="{StaticResource PosSurfaceAltBrush}"
             Loaded="CardRecoveryCenterView_OnLoaded">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style x:Key="RecoveryListItemStyle" TargetType="ListBoxItem">
            <Setter Property="MinHeight" Value="76" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{StaticResource PosSurfaceAltBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource PosBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#FFEAF2FF" />
                    <Setter Property="BorderBrush" Value="{StaticResource PosPrimaryBrush}" />
                    <Setter Property="BorderThickness" Value="2" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RecoveryFieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource PosMutedForegroundBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="RecoveryFieldValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource PosTextBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Command="{Binding BackCommand}"
                    Style="{StaticResource PosSecondaryButtonStyle}"
                    MinWidth="112"
                    MinHeight="48"
                    Padding="16,0">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="ArrowLeft" Width="18" Height="18" Margin="0,0,8,0" />
                    <TextBlock Text="{loc:Loc cardRecovery.center.action.back}" FontWeight="SemiBold" />
                </StackPanel>
            </Button>

            <StackPanel Grid.Column="1" Margin="18,0" VerticalAlignment="Center">
                <TextBlock Text="{loc:Loc cardRecovery.center.title}"
                           FontSize="26"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource PosTextBrush}" />
                <TextBlock Text="{loc:Loc cardRecovery.center.subtitle}"
                           Margin="0,4,0,0"
                           FontSize="12"
                           Foreground="{StaticResource PosMutedForegroundBrush}"
                           TextWrapping="Wrap" />
            </StackPanel>

            <Button Grid.Column="2"
                    Command="{Binding RefreshCommand}"
                    Style="{StaticResource PosSecondaryButtonStyle}"
                    MinWidth="124"
                    MinHeight="48"
                    Padding="16,0">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Refresh" Width="18" Height="18" Margin="0,0,8,0" />
                    <TextBlock Text="{loc:Loc cardRecovery.center.action.refresh}" FontWeight="SemiBold" />
                </StackPanel>
            </Button>
        </Grid>

        <Grid x:Name="RecoveryMasterDetailGrid" Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.9*" MinWidth="340" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="1.5*" MinWidth="580" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource PosCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{loc:Loc cardRecovery.center.list.title}"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource PosTextBrush}"
                                   VerticalAlignment="Center" />
                        <Border Grid.Column="1"
                                Background="#FFFFF1D6"
                                CornerRadius="12"
                                Padding="10,5">
                            <TextBlock Text="{Binding OpenCountText}"
                                       Foreground="{StaticResource PosTextBrush}"
                                       FontSize="11"
                                       FontWeight="SemiBold" />
                        </Border>
                    </Grid>

                    <Grid Grid.Row="2">
                        <ListBox x:Name="OpenAttemptsList"
                                 ItemsSource="{Binding OpenAttempts}"
                                 SelectedItem="{Binding SelectedAttempt, Mode=TwoWay}"
                                 ItemContainerStyle="{StaticResource RecoveryListItemStyle}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.PanningMode="VerticalOnly">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding OperationKind}"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource PosTextBrush}" />
                                                <TextBlock Text=" · " Foreground="{StaticResource PosMutedForegroundBrush}" />
                                                <TextBlock Text="{Binding Processor}"
                                                           Foreground="{StaticResource PosMutedForegroundBrush}" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding UpdatedAt, StringFormat={}{0:g}}"
                                                       Margin="0,7,0,0"
                                                       FontSize="11"
                                                       Foreground="{StaticResource PosMutedForegroundBrush}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="12,0,0,0" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding Amount, StringFormat={}{0:C2}}"
                                                       HorizontalAlignment="Right"
                                                       FontSize="17"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource PosPrimaryBrush}" />
                                            <TextBlock Text="{Binding Status}"
                                                       Margin="0,7,0,0"
                                                       HorizontalAlignment="Right"
                                                       FontSize="11"
                                                       Foreground="{StaticResource PosMutedForegroundBrush}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding HasNoOpenAttempts, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <materialDesign:PackIcon Kind="CheckCircleOutline"
                                                     Width="34"
                                                     Height="34"
                                                     Foreground="{StaticResource PosMutedForegroundBrush}"
                                                     HorizontalAlignment="Center" />
                            <TextBlock Text="{loc:Loc cardRecovery.center.list.empty}"
                                       Margin="0,10,0,0"
                                       Foreground="{StaticResource PosMutedForegroundBrush}"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource PosCardStyle}" Padding="18,16">
                <Grid>
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="{Binding HasNoSelection, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <materialDesign:PackIcon Kind="CreditCardSearchOutline"
                                                 Width="38"
                                                 Height="38"
                                                 Foreground="{StaticResource PosMutedForegroundBrush}"
                                                 HorizontalAlignment="Center" />
                        <TextBlock Text="{loc:Loc cardRecovery.center.detail.empty}"
                                   Margin="0,10,0,0"
                                   Foreground="{StaticResource PosMutedForegroundBrush}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <ScrollViewer x:Name="DetailScrollViewer"
                                  PanningMode="VerticalOnly"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Visibility="{Binding HasSelection, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Margin="0,0,6,0">
                            <TextBlock Text="{loc:Loc cardRecovery.center.detail.title}"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource PosTextBrush}" />

                            <Border Margin="0,12,0,0"
                                    Padding="14"
                                    Background="{StaticResource PosSurfaceAltBrush}"
                                    CornerRadius="6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding SelectedTypeText}"
                                                   FontSize="18"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource PosTextBrush}" />
                                        <TextBlock Text="{Binding SelectedChannelText}"
                                                   Margin="0,4,0,0"
                                                   Foreground="{StaticResource PosMutedForegroundBrush}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding SelectedAmountText}"
                                               Margin="16,0,0,0"
                                               FontSize="24"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource PosPrimaryBrush}"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="118" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="118" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Loc cardRecovery.center.field.type}" Style="{StaticResource RecoveryFieldLabelStyle}" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedTypeText}" Style="{StaticResource RecoveryFieldValueStyle}" />
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="{loc:Loc cardRecovery.center.field.channel}" Style="{StaticResource RecoveryFieldLabelStyle}" />
                                <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding SelectedChannelText}" Style="{StaticResource RecoveryFieldValueStyle}" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,10,0,0" Text="{loc:Loc cardRecovery.center.field.amount}" Style="{StaticResource RecoveryFieldLabelStyle}" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,10,0,0" Text="{Binding SelectedAmountText}" Style="{StaticResource RecoveryFieldValueStyle}" />
                                <TextBlock Grid.Row="1" Grid.Column="2" Margin="0,10,0,0" Text="{loc:Loc cardRecovery.center.field.cashier}" Style="{StaticResource RecoveryFieldLabelStyle}" />
                                <TextBlock Grid.Row="1" Grid.Column="3" Margin="0,10,0,0" Text="{Binding SelectedCashierText}" Style="{StaticResource RecoveryFieldValueStyle}" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,10,0,0" Text="{loc:Loc cardRecovery.center.field.time}" Style="{StaticResource RecoveryFieldLabelStyle}" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,10,0,0" Text="{Binding SelectedTimeText}" Style="{StaticResource RecoveryFieldValueStyle}" />
                                <TextBlock Grid.Row="2" Grid.Column="2" Margin="0,10,0,0" Text="{loc:Loc cardRecovery.center.field.status}" Style="{StaticResource RecoveryFieldLabelStyle}" />
                                <TextBlock Grid.Row="2" Grid.Column="3" Margin="0,10,0,0" Text="{Binding SelectedStatusText}" Style="{StaticResource RecoveryFieldValueStyle}" />

                                <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,10,0,0" Text="{loc:Loc cardRecovery.center.field.session}" Style="{StaticResource RecoveryFieldLabelStyle}" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,10,0,0" Text="{Binding SelectedSessionText}" Style="{StaticResource RecoveryFieldValueStyle}" />
                                <TextBlock Grid.Row="3" Grid.Column="2" Margin="0,10,0,0" Text="{loc:Loc cardRecovery.center.field.txn}" Style="{StaticResource RecoveryFieldLabelStyle}" />
                                <TextBlock Grid.Row="3" Grid.Column="3" Margin="0,10,0,0" Text="{Binding SelectedTxnText}" Style="{StaticResource RecoveryFieldValueStyle}" />

                                <TextBlock Grid.Row="4" Grid.Column="0" Margin="0,10,0,0" Text="{loc:Loc cardRecovery.center.field.responseCode}" Style="{StaticResource RecoveryFieldLabelStyle}" />
                                <TextBlock Grid.Row="4" Grid.Column="1" Margin="0,10,0,0" Text="{Binding SelectedResponseCodeText}" Style="{StaticResource RecoveryFieldValueStyle}" />
                                <TextBlock Grid.Row="4" Grid.Column="2" Margin="0,10,0,0" Text="{loc:Loc cardRecovery.center.field.responseText}" Style="{StaticResource RecoveryFieldLabelStyle}" />
                                <TextBlock Grid.Row="4" Grid.Column="3" Margin="0,10,0,0" Text="{Binding SelectedResponseText}" Style="{StaticResource RecoveryFieldValueStyle}" />

                                <TextBlock Grid.Row="5" Grid.Column="0" Margin="0,10,0,0" Text="{loc:Loc cardRecovery.center.field.attempt}" Style="{StaticResource RecoveryFieldLabelStyle}" />
                                <TextBlock Grid.Row="5" Grid.Column="1" Margin="0,10,0,0" Text="{Binding SelectedAttemptText}" Style="{StaticResource RecoveryFieldValueStyle}" />
                                <TextBlock Grid.Row="5" Grid.Column="2" Margin="0,10,0,0" Text="{loc:Loc cardRecovery.center.field.environment}" Style="{StaticResource RecoveryFieldLabelStyle}" />
                                <TextBlock Grid.Row="5" Grid.Column="3" Margin="0,10,0,0" Text="{Binding SelectedEnvironmentText}" Style="{StaticResource RecoveryFieldValueStyle}" />
                            </Grid>

                            <TextBlock Text="{loc:Loc cardRecovery.center.field.products}"
                                       Margin="0,16,0,0"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource PosTextBrush}" />
                            <Border Margin="0,8,0,0"
                                    BorderBrush="{StaticResource PosBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="5">
                                <Grid>
                                    <StackPanel Visibility="{Binding HasProductSnapshot, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Grid Background="{StaticResource PosSurfaceAltBrush}" Height="34">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*" />
                                                <ColumnDefinition Width="1.2*" />
                                                <ColumnDefinition Width="0.7*" />
                                                <ColumnDefinition Width="0.9*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Margin="10,0" Text="{loc:Loc cardRecovery.center.product.name}" Style="{StaticResource RecoveryFieldLabelStyle}" />
                                            <TextBlock Grid.Column="1" Margin="8,0" Text="{loc:Loc cardRecovery.center.product.code}" Style="{StaticResource RecoveryFieldLabelStyle}" />
                                            <TextBlock Grid.Column="2" Margin="8,0" Text="{loc:Loc cardRecovery.center.product.quantity}" Style="{StaticResource RecoveryFieldLabelStyle}" />
                                            <TextBlock Grid.Column="3" Margin="8,0" Text="{loc:Loc cardRecovery.center.product.unitPrice}" Style="{StaticResource RecoveryFieldLabelStyle}" />
                                        </Grid>
                                        <ItemsControl ItemsSource="{Binding SelectedProductLines}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid MinHeight="36">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="2*" />
                                                            <ColumnDefinition Width="1.2*" />
                                                            <ColumnDefinition Width="0.7*" />
                                                            <ColumnDefinition Width="0.9*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Margin="10,0" Text="{Binding DisplayName}" Style="{StaticResource RecoveryFieldValueStyle}" />
                                                        <TextBlock Grid.Column="1" Margin="8,0" Text="{Binding ProductCode}" Style="{StaticResource RecoveryFieldValueStyle}" />
                                                        <TextBlock Grid.Column="2" Margin="8,0" Text="{Binding Quantity, StringFormat={}{0:0.###}}" Style="{StaticResource RecoveryFieldValueStyle}" />
                                                        <TextBlock Grid.Column="3" Margin="8,0" Text="{Binding UnitPrice, StringFormat={}{0:C2}}" Style="{StaticResource RecoveryFieldValueStyle}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                    <TextBlock Text="{loc:Loc cardRecovery.center.product.unavailable}"
                                               Padding="12"
                                               Foreground="{StaticResource PosMutedForegroundBrush}"
                                               TextWrapping="Wrap"
                                               Visibility="{Binding HasNoProductSnapshot, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </Grid>
                            </Border>

                            <Border Margin="0,16,0,0"
                                    Padding="14"
                                    Background="#FFFFFAEC"
                                    BorderBrush="#FFE9C46A"
                                    BorderThickness="1"
                                    CornerRadius="6">
                                <StackPanel>
                                    <TextBlock Text="{Binding ResolutionSectionTitleText}"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource PosTextBrush}" />
                                    <TextBlock Text="{Binding ResolutionInstructionsText}"
                                               Margin="0,4,0,0"
                                               FontSize="11"
                                               Foreground="{StaticResource PosMutedForegroundBrush}"
                                               TextWrapping="Wrap" />
                                    <StackPanel Margin="0,12,0,0">
                                        <TextBlock Text="{Binding ResolutionReasonLabelText}"
                                                   Style="{StaticResource RecoveryFieldLabelStyle}" />
                                        <TextBox Text="{Binding ResolutionReason, UpdateSourceTrigger=PropertyChanged}"
                                                 AutomationProperties.Name="{Binding ResolutionReasonLabelText}"
                                                 Margin="0,6,0,0"
                                                 MinHeight="44"
                                                 ScrollViewer.PanningMode="None"
                                                 Style="{StaticResource PosSearchTextBoxStyle}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,10,0,0">
                                        <TextBlock Text="{Binding ResolutionEvidenceLabelText}"
                                                   Style="{StaticResource RecoveryFieldLabelStyle}" />
                                        <TextBox Text="{Binding ResolutionEvidence, UpdateSourceTrigger=PropertyChanged}"
                                                 AutomationProperties.Name="{Binding ResolutionEvidenceLabelText}"
                                                 Margin="0,6,0,0"
                                                 MinHeight="68"
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap"
                                                 VerticalScrollBarVisibility="Auto"
                                                 ScrollViewer.PanningMode="VerticalFirst"
                                                 Style="{StaticResource PosSearchTextBoxStyle}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,10,0,0">
                                        <TextBlock Text="{Binding ResolutionReferenceLabelText}"
                                                   Style="{StaticResource RecoveryFieldLabelStyle}" />
                                        <TextBox Text="{Binding ResolutionReference, UpdateSourceTrigger=PropertyChanged}"
                                                 AutomationProperties.Name="{Binding ResolutionReferenceLabelText}"
                                                 Margin="0,6,0,0"
                                                 MinHeight="44"
                                                 ScrollViewer.PanningMode="None"
                                                 Style="{StaticResource PosSearchTextBoxStyle}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Button Command="{Binding RecoverCommand}"
                                    Style="{StaticResource PosPrimaryButtonStyle}"
                                    MinHeight="52"
                                    Margin="0,14,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="ShieldRefreshOutline" Width="18" Height="18" Margin="0,0,8,0" />
                                    <TextBlock Text="{loc:Loc cardRecovery.center.action.recover}" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0"
                                        Command="{Binding ConfirmPaidCommand}"
                                        Style="{StaticResource PosDangerButtonStyle}"
                                        MinHeight="52"
                                        Padding="10,4">
                                    <TextBlock Text="{loc:Loc cardRecovery.center.action.confirmPaid}" TextWrapping="Wrap" TextAlignment="Center" />
                                </Button>
                                <Button Grid.Column="2"
                                        Command="{Binding ConfirmNotPaidCommand}"
                                        Style="{StaticResource PosSecondaryButtonStyle}"
                                        MinHeight="52"
                                        Padding="10,4">
                                    <TextBlock Text="{loc:Loc cardRecovery.center.action.confirmNotPaid}" TextWrapping="Wrap" TextAlignment="Center" />
                                </Button>
                                <Button Grid.Column="4"
                                        Command="{Binding ContinueWaitingCommand}"
                                        Style="{StaticResource PosSecondaryButtonStyle}"
                                        MinHeight="52"
                                        Padding="10,4">
                                    <TextBlock Text="{loc:Loc cardRecovery.center.action.continueWaiting}" TextWrapping="Wrap" TextAlignment="Center" />
                                </Button>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="4"
                Style="{StaticResource PosCardStyle}"
                Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="160" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="{StaticResource PosMutedForegroundBrush}"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap" />
                <ProgressBar Grid.Column="1"
                             Margin="16,0,0,0"
                             Height="4"
                             IsIndeterminate="True"
                             VerticalAlignment="Center"
                             Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
