<UserControl x:Class="Hbpos.Client.Wpf.Views.Screens.DailyCloseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:Hbpos.Client.Wpf.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:loc="clr-namespace:Hbpos.Client.Wpf.Localization"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:services="clr-namespace:Hbpos.Client.Wpf.Services"
             mc:Ignorable="d"
             d:DesignHeight="688"
             d:DesignWidth="1366"
             Background="#FFF9F9FD">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:CashDenominationAccentBrushConverter x:Key="CashDenominationAccentBrush" />
        <converters:StringNullOrWhiteSpaceToVisibilityConverter x:Key="StringHasValueToVis" />
        <converters:StringNullOrWhiteSpaceToVisibilityConverter x:Key="StringIsEmptyToVis" Invert="True" />

        <Style x:Key="SettlementCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#1FC3C6D6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="10"
                                      ShadowDepth="1"
                                      Opacity="0.08"
                                      Color="#FF101828" />
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettlementLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#FF737785" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
            <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
        </Style>

        <Style x:Key="SettlementTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="Black" />
            <Setter Property="Foreground" Value="#FF0040A1" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
            <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
        </Style>

        <Style x:Key="SettlementValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="19" />
            <Setter Property="FontWeight" Value="Black" />
            <Setter Property="Foreground" Value="#FF191C1E" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
            <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
        </Style>

        <Style x:Key="DenominationBadgeStyle" TargetType="Border">
            <Setter Property="MinWidth" Value="58" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

        <Style x:Key="CashDenominationButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="54" />
            <Setter Property="Margin" Value="0,0,0,7" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#FFE2E2E6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#FF191C1E" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#FFF7FAFF" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="#FF80A9E8" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="#FF0056D2" />
                                <Setter TargetName="Root" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#FFEAF2FF" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="#FF0056D2" />
                                <Setter TargetName="Root" Property="BorderThickness" Value="2" />
                            </DataTrigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.78" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="KeypadButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="58" />
            <Setter Property="MinWidth" Value="84" />
            <Setter Property="Margin" Value="5" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#FFC3C6D6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#FF191C1E" />
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="Black" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextBlock.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#FFEAF2FF" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="#FF0056D2" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#FFD6E4FA" />
                                <Setter TargetName="Root" Property="Opacity" Value="0.82" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="CashDenominationItemTemplate">
            <Button Command="{Binding DataContext.OpenCashCountDialogCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                    CommandParameter="{Binding}"
                    AutomationProperties.Name="{Binding Label}"
                    Style="{StaticResource CashDenominationButtonStyle}">
                <Grid Margin="12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="82" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="92" />
                        <ColumnDefinition Width="22" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Style="{StaticResource DenominationBadgeStyle}"
                            Background="{Binding Value, Converter={StaticResource CashDenominationAccentBrush}, ConverterParameter=Background}"
                            BorderBrush="{Binding Value, Converter={StaticResource CashDenominationAccentBrush}, ConverterParameter=BorderBrush}">
                        <TextBlock Text="{Binding Label}"
                                   Foreground="{Binding Value, Converter={StaticResource CashDenominationAccentBrush}, ConverterParameter=Foreground}"
                                   FontSize="14"
                                   FontWeight="Black"
                                   HorizontalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{loc:Loc dailyClose.quantityShort}"
                                   Foreground="#FF737785"
                                   FontSize="11"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Count}"
                                   Margin="5,0,0,0"
                                   Foreground="#FF191C1E"
                                   FontSize="14"
                                   FontWeight="Black" />
                    </StackPanel>

                    <TextBlock Grid.Column="2"
                               Text="{Binding Subtotal, StringFormat={}{0:C2}}"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Right"
                               Foreground="#FF191C1E"
                               FontSize="14"
                               FontWeight="Black" />
                    <materialDesign:PackIcon Grid.Column="3"
                                             Kind="ChevronRight"
                                             Width="18"
                                             Height="18"
                                             VerticalAlignment="Center"
                                             HorizontalAlignment="Right"
                                             Foreground="#FF737785" />
                </Grid>
            </Button>
        </DataTemplate>

        <Style x:Key="DailyCloseTabItemStyle" TargetType="{x:Type TabItem}">
            <Setter Property="Height" Value="38" />
            <Setter Property="MinWidth" Value="132" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Foreground" Value="#FF424654" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Black" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabItem}">
                        <Border x:Name="Root"
                                Background="#FFF9F9FD"
                                BorderBrush="#FFC3C6D6"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"
                                              TextBlock.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#FFEAF2FF" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="#FF80A9E8" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#FF0056D2" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="#FF0056D2" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DailyCloseTabControlStyle" TargetType="{x:Type TabControl}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource DailyCloseTabItemStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabControl}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0"
                                    Background="#FFEDEEF1"
                                    BorderBrush="#FFE2E2E6"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="14,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Button Grid.Column="0"
                                            Command="{Binding ReturnToPosCommand}"
                                            Height="36"
                                            Padding="11,0"
                                            Margin="0,0,12,0"
                                            Style="{StaticResource PosSecondaryButtonStyle}">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="ArrowLeft" Width="16" Height="16" Margin="0,0,6,0" />
                                            <TextBlock Text="{loc:Loc shell.backToPos}" FontWeight="Bold" />
                                        </StackPanel>
                                    </Button>

                                    <StackPanel Grid.Column="1" Margin="0,0,16,0">
                                        <TextBlock Text="{loc:Loc dailyClose.businessDate}" Style="{StaticResource SettlementLabelStyle}" />
                                        <DatePicker SelectedDate="{Binding SelectedDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                    Height="34"
                                                    MinWidth="184"
                                                    FontSize="14" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,14,0">
                                        <TextBlock Text="{loc:Loc dailyClose.title}"
                                                   FontSize="18"
                                                   FontWeight="Black"
                                                   Foreground="#FF0040A1" />
                                        <TextBlock Text="{Binding StatusMessage}"
                                                   Margin="0,2,0,0"
                                                   FontSize="12"
                                                   Foreground="#FF424654"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <Border Grid.Column="3"
                                            Background="#FFFFFFFF"
                                            BorderBrush="#FFC3C6D6"
                                            BorderThickness="1"
                                            CornerRadius="7"
                                            Padding="2"
                                            Margin="0,0,10,0">
                                        <TabPanel IsItemsHost="True"
                                                  KeyboardNavigation.TabIndex="1"
                                                  Background="Transparent" />
                                    </Border>

                                    <Button Grid.Column="4"
                                            Command="{Binding RefreshSummaryCommand}"
                                            Height="36"
                                            MinWidth="118"
                                            Margin="0,0,10,0"
                                            Style="{StaticResource PosPrimaryButtonStyle}">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Sync" Width="16" Height="16" Margin="0,0,6,0" Foreground="White" />
                                            <TextBlock Text="{loc:Loc dailyClose.refresh}" Foreground="White" FontWeight="Bold" />
                                        </StackPanel>
                                    </Button>

                                    <Button Grid.Column="5"
                                            Command="{Binding SaveAndPrintCommand}"
                                            Height="36"
                                            MinWidth="150"
                                            Style="{StaticResource PosPrimaryButtonStyle}">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="ContentSaveCheck" Width="16" Height="16" Margin="0,0,6,0" Foreground="White" />
                                            <TextBlock Text="{loc:Loc dailyClose.saveFinalize}" Foreground="White" FontWeight="Bold" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>

                            <ContentPresenter x:Name="PART_SelectedContentHost"
                                              Grid.Row="1"
                                              Margin="0,10,0,0"
                                              ContentSource="SelectedContent" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettlementDataGridStyle" TargetType="DataGrid" BasedOn="{StaticResource PosCartDataGridStyle}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="GridLinesVisibility" Value="None" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="RowHeight" Value="44" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <TabControl Margin="20"
                    SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}"
                    Style="{StaticResource DailyCloseTabControlStyle}">
            <TabItem Header="{loc:Loc dailyClose.tab.count}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.1*" MinWidth="720" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="0.9*" MinWidth="300" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.6*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="0.58*" />
                            </Grid.ColumnDefinitions>

                            <Border x:Name="CashCountPanel"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="3"
                                    Style="{StaticResource SettlementCardStyle}"
                                    Padding="18,14">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <StackPanel>
                                        <TextBlock Text="{loc:Loc dailyClose.cashCounter}" Style="{StaticResource SettlementTitleStyle}" />
                                        <TextBlock Text="{loc:Loc dailyClose.cashCountHint}"
                                                   Margin="0,3,0,0"
                                                   FontSize="11"
                                                   Foreground="#FF737785" />
                                    </StackPanel>

                                    <Grid Grid.Row="1" Margin="0,12,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="14" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Grid Grid.Column="0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="{loc:Loc dailyClose.notes}"
                                                       Style="{StaticResource SettlementLabelStyle}"
                                                       FontSize="12" />
                                            <ScrollViewer Grid.Row="1"
                                                          Margin="0,7,0,0"
                                                          VerticalScrollBarVisibility="Auto"
                                                          HorizontalScrollBarVisibility="Disabled">
                                                <ItemsControl x:Name="NoteDenominationList"
                                                              ItemsSource="{Binding NoteDenominations}"
                                                              ItemTemplate="{StaticResource CashDenominationItemTemplate}" />
                                            </ScrollViewer>
                                        </Grid>

                                        <Grid Grid.Column="2">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="{loc:Loc dailyClose.coins}"
                                                       Style="{StaticResource SettlementLabelStyle}"
                                                       FontSize="12" />
                                            <ScrollViewer Grid.Row="1"
                                                          Margin="0,7,0,0"
                                                          VerticalScrollBarVisibility="Auto"
                                                          HorizontalScrollBarVisibility="Disabled">
                                                <ItemsControl x:Name="CoinDenominationList"
                                                              ItemsSource="{Binding CoinDenominations}"
                                                              ItemTemplate="{StaticResource CashDenominationItemTemplate}" />
                                            </ScrollViewer>
                                        </Grid>
                                    </Grid>

                                    <Grid Grid.Row="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0"
                                                Background="#FFF3F3F7"
                                                CornerRadius="8"
                                                Padding="12,8">
                                            <StackPanel>
                                                <TextBlock Text="{loc:Loc dailyClose.noteTotal}" Style="{StaticResource SettlementLabelStyle}" />
                                                <TextBlock Text="{Binding NoteSubtotal, StringFormat={}{0:C2}}" Style="{StaticResource SettlementValueStyle}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="2"
                                                Background="#FFF3F3F7"
                                                CornerRadius="8"
                                                Padding="12,8">
                                            <StackPanel>
                                                <TextBlock Text="{loc:Loc dailyClose.coinTotal}" Style="{StaticResource SettlementLabelStyle}" />
                                                <TextBlock Text="{Binding CoinSubtotal, StringFormat={}{0:C2}}" Style="{StaticResource SettlementValueStyle}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="4"
                                                Background="#FFEAF2FF"
                                                BorderBrush="#FF80A9E8"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="12,8">
                                            <StackPanel>
                                                <TextBlock Text="{loc:Loc dailyClose.cashCounted}" Style="{StaticResource SettlementLabelStyle}" Foreground="#FF0040A1" />
                                                <TextBlock Text="{Binding CountedCashAmount, StringFormat={}{0:C2}}" Style="{StaticResource SettlementValueStyle}" Foreground="#FF0040A1" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>

                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource SettlementCardStyle}" Padding="0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0"
                                        BorderBrush="#FFC3C6D6"
                                        BorderThickness="0,0,0,1"
                                        Padding="18"
                                        Background="White">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="{loc:Loc dailyClose.reportTitle}"
                                                   FontSize="20"
                                                   FontWeight="Black"
                                                   Foreground="#FF191C1E"
                                                   HorizontalAlignment="Center" />
                                        <TextBlock Text="{Binding BusinessDateText}"
                                                   Margin="0,4,0,0"
                                           FontSize="10"
                                           Foreground="#FF737785"
                                           HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>

                                <Grid Grid.Row="1" Margin="16,12,16,14">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="8" />
                                        <RowDefinition Height="132" />
                                        <RowDefinition Height="10" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="{loc:Loc dailyClose.systemTotals}"
                                               Style="{StaticResource SettlementTitleStyle}"
                                               FontSize="15" />

                                    <DataGrid Grid.Row="2"
                                              ItemsSource="{Binding PaymentSummaries}"
                                              Style="{StaticResource SettlementDataGridStyle}"
                                              RowHeight="28"
                                              FontSize="11"
                                              ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="{loc:Loc dailyClose.method}" Binding="{Binding Label}" Width="*" />
                                            <DataGridTextColumn Header="{loc:Loc dailyClose.sales}" Binding="{Binding SalesAmount, StringFormat={}{0:C2}}" Width="74" />
                                            <DataGridTextColumn Header="{loc:Loc dailyClose.refund}" Binding="{Binding RefundAmount, StringFormat={}{0:C2}}" Width="74" />
                                            <DataGridTextColumn Header="{loc:Loc dailyClose.net}" Binding="{Binding NetAmount, StringFormat={}{0:C2}}" Width="74" />
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <Separator Grid.Row="4" Margin="0,0,0,10" />

                                    <Grid Grid.Row="5">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <Grid Margin="0,0,0,8">
                                            <TextBlock Text="{loc:Loc dailyClose.totalNetSales}" Foreground="#FF424654" />
                                            <TextBlock Text="{Binding NetAmount, StringFormat={}{0:C2}}" HorizontalAlignment="Right" FontWeight="SemiBold" />
                                        </Grid>
                                        <Grid Grid.Row="1" Margin="0,0,0,8">
                                            <TextBlock Text="{loc:Loc dailyClose.expectedCash}" Foreground="#FF424654" />
                                            <TextBlock Text="{Binding ExpectedCashAmount, StringFormat={}{0:C2}}" HorizontalAlignment="Right" FontWeight="SemiBold" />
                                        </Grid>
                                        <Grid Grid.Row="2" Margin="0,0,0,8">
                                            <TextBlock Text="{loc:Loc dailyClose.cashCounted}" FontWeight="Bold" />
                                            <TextBlock Text="{Binding CountedCashAmount, StringFormat={}{0:C2}}" HorizontalAlignment="Right" FontWeight="Black" />
                                        </Grid>
                                        <Grid Grid.Row="3" Margin="0,2,0,10">
                                            <TextBlock Text="{loc:Loc dailyClose.overShort}" FontWeight="Bold" />
                                            <TextBlock Text="{Binding CashDifference, StringFormat={}{0:C2}}" HorizontalAlignment="Right" FontWeight="Black" Foreground="#FFBA1A1A" />
                                        </Grid>
                                        <Grid Grid.Row="4" Margin="0,0,0,8">
                                            <TextBlock Text="{loc:Loc dailyClose.refundAmount}" Foreground="#FF424654" />
                                            <TextBlock Text="{Binding RefundAmount, StringFormat={}{0:C2}}" HorizontalAlignment="Right" />
                                        </Grid>
                                        <Grid Grid.Row="5" Margin="0,0,0,8">
                                            <TextBlock Text="{loc:Loc dailyClose.returnQty}" Foreground="#FF424654" />
                                            <TextBlock Text="{Binding ReturnQuantity}" HorizontalAlignment="Right" />
                                        </Grid>
                                        <Grid Grid.Row="6">
                                            <TextBlock Text="{loc:Loc dailyClose.orders}" Foreground="#FF424654" />
                                            <TextBlock Text="{Binding TransactionCount}" HorizontalAlignment="Right" />
                                        </Grid>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Border>

                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="{loc:Loc dailyClose.tab.history}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.05*" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="0.95*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource SettlementCardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="16" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{loc:Loc dailyClose.history.title}" Style="{StaticResource SettlementTitleStyle}" />
                                    <TextBlock Text="{Binding BusinessDateText}"
                                               Margin="0,4,0,0"
                                               Foreground="#FF737785" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Command="{Binding LoadHistoryCommand}"
                                        Height="42"
                                        MinWidth="132"
                                        Style="{StaticResource PosPrimaryButtonStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Sync" Width="17" Height="17" Margin="0,0,7,0" Foreground="White" />
                                        <TextBlock Text="{loc:Loc dailyClose.history.load}" Foreground="White" FontWeight="Bold" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <DataGrid Grid.Row="2"
                                      ItemsSource="{Binding Archives}"
                                      SelectedItem="{Binding SelectedArchive, Mode=TwoWay}"
                                      Style="{StaticResource SettlementDataGridStyle}"
                                      RowHeight="52">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{loc:Loc Time}" Binding="{Binding ClosedAtDisplay}" Width="150" />
                                    <DataGridTextColumn Header="{loc:Loc Cashier}" Binding="{Binding OperatorName}" Width="*" />
                                    <DataGridTextColumn Header="{loc:Loc dailyClose.cashCounted}" Binding="{Binding CountedCashAmount, StringFormat={}{0:C2}}" Width="120" />
                                    <DataGridTextColumn Header="{loc:Loc dailyClose.cashDifference}" Binding="{Binding CashDifference, StringFormat={}{0:C2}}" Width="120" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="1.05*" />
                            <RowDefinition Height="14" />
                            <RowDefinition Height="0.95*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource SettlementCardStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="{loc:Loc dailyClose.receiptPreview}" Style="{StaticResource SettlementTitleStyle}" />
                                <ScrollViewer Grid.Row="1" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding ArchivePreviewRows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Text}"
                                                           Margin="0,0,0,3"
                                                           FontFamily="Consolas"
                                                           FontSize="11"
                                                           TextWrapping="Wrap">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="TextAlignment" Value="Left" />
                                                            <Setter Property="Foreground" Value="#FF191C1E" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCentered}" Value="True">
                                                                    <Setter Property="TextAlignment" Value="Center" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsRightAligned}" Value="True">
                                                                    <Setter Property="TextAlignment" Value="Right" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsEmphasized}" Value="True">
                                                                    <Setter Property="FontWeight" Value="Black" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>

                        <Border Grid.Row="2" Style="{StaticResource SettlementCardStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="{loc:Loc dailyClose.cashDetail}" Style="{StaticResource SettlementTitleStyle}" />
                                <ScrollViewer Grid.Row="1" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <TextBlock Text="{loc:Loc dailyClose.notes}" Style="{StaticResource SettlementLabelStyle}" />
                                        <DataGrid ItemsSource="{Binding SelectedArchiveNoteCounts}"
                                                  Margin="0,6,0,0"
                                                  Style="{StaticResource SettlementDataGridStyle}"
                                                  RowHeight="36">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="{loc:Loc dailyClose.denomination}" Binding="{Binding Label}" Width="*" />
                                                <DataGridTextColumn Header="{loc:Loc dailyClose.quantity}" Binding="{Binding Quantity}" Width="70" />
                                                <DataGridTextColumn Header="{loc:Loc dailyClose.subtotal}" Binding="{Binding Amount, StringFormat={}{0:C2}}" Width="96" />
                                            </DataGrid.Columns>
                                        </DataGrid>

                                        <TextBlock Text="{loc:Loc dailyClose.coins}" Margin="0,14,0,6" Style="{StaticResource SettlementLabelStyle}" />
                                        <DataGrid ItemsSource="{Binding SelectedArchiveCoinCounts}"
                                                  Style="{StaticResource SettlementDataGridStyle}"
                                                  RowHeight="36">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="{loc:Loc dailyClose.denomination}" Binding="{Binding Label}" Width="*" />
                                                <DataGridTextColumn Header="{loc:Loc dailyClose.quantity}" Binding="{Binding Quantity}" Width="70" />
                                                <DataGridTextColumn Header="{loc:Loc dailyClose.subtotal}" Binding="{Binding Amount, StringFormat={}{0:C2}}" Width="96" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </Border>

                        <Button Grid.Row="3"
                                Command="{Binding ReprintSelectedArchiveCommand}"
                                Height="50"
                                Margin="0,14,0,0"
                                Style="{StaticResource PosPrimaryButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Printer" Width="18" Height="18" Margin="0,0,8,0" Foreground="White" />
                                <TextBlock Text="{loc:Loc dailyClose.reprint}" Foreground="White" FontWeight="Bold" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="{loc:Loc dailyClose.linklySettlement.tab}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.12*" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="0.88*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource SettlementCardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="16" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{loc:Loc dailyClose.linklySettlement.title}" Style="{StaticResource SettlementTitleStyle}" />
                                    <TextBlock Text="{loc:Loc dailyClose.linklySettlement.hint}"
                                               Margin="0,4,0,0"
                                               Foreground="#FF737785" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Command="{Binding LoadSettlementHistoryCommand}"
                                        Height="42"
                                        MinWidth="104"
                                        Margin="0,0,10,0"
                                        Style="{StaticResource PosSecondaryButtonStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Sync" Width="17" Height="17" Margin="0,0,7,0" />
                                        <TextBlock Text="{loc:Loc dailyClose.linklySettlement.refresh}" FontWeight="Bold" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="2"
                                        Command="{Binding SettleAndPrintCommand}"
                                        Height="42"
                                        MinWidth="142"
                                        Style="{StaticResource PosPrimaryButtonStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Printer" Width="17" Height="17" Margin="0,0,7,0" Foreground="White" />
                                        <TextBlock Text="{loc:Loc dailyClose.linklySettlement.settleAndPrint}" Foreground="White" FontWeight="Bold" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <DataGrid Grid.Row="2"
                                      ItemsSource="{Binding Settlements}"
                                      SelectedItem="{Binding SelectedSettlement, Mode=TwoWay}"
                                      Style="{StaticResource SettlementDataGridStyle}"
                                      RowHeight="52">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{loc:Loc dailyClose.linklySettlement.time}" Binding="{Binding RequestedAtDisplay}" Width="145" />
                                    <DataGridTextColumn Header="{loc:Loc dailyClose.linklySettlement.mode}" Binding="{Binding ConnectionMode}" Width="120" />
                                    <DataGridTextColumn Header="{loc:Loc dailyClose.linklySettlement.result}" Binding="{Binding Status}" Width="88" />
                                    <DataGridTextColumn Header="{loc:Loc dailyClose.linklySettlement.submission}" Binding="{Binding ProviderSubmissionState}" Width="104" />
                                    <DataGridTextColumn Header="{loc:Loc dailyClose.linklySettlement.receipt}" Binding="{Binding ReceiptTexts.Count}" Width="58" />
                                    <DataGridTextColumn Header="{loc:Loc dailyClose.linklySettlement.printCount}" Binding="{Binding PrintCount}" Width="78" />
                                    <DataGridTextColumn Header="{loc:Loc dailyClose.linklySettlement.response}" Binding="{Binding ResponseText}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border Style="{StaticResource SettlementCardStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="{loc:Loc dailyClose.linklySettlement.preview}" Style="{StaticResource SettlementTitleStyle}" />
                                <ScrollViewer Grid.Row="1" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding SettlementReceiptPreviewLines}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}"
                                                           Margin="0,0,0,3"
                                                           FontFamily="Consolas"
                                                           FontSize="11"
                                                           Foreground="#FF191C1E"
                                                           TextWrapping="Wrap" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>

                        <Border Grid.Row="1"
                                Margin="0,14,0,0"
                                Padding="12"
                                Background="#FFFDF8E8"
                                BorderBrush="#FFE0C56B"
                                BorderThickness="1"
                                CornerRadius="6"
                                Visibility="{Binding IsSettlementManualResolutionVisible, Converter={StaticResource BoolToVis}}"
                                AutomationProperties.Name="{loc:Loc dailyClose.linklySettlement.manual.automationName}">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc dailyClose.linklySettlement.manual.title}"
                                           FontWeight="Bold"
                                           Foreground="#FF694F00" />
                                <TextBlock Text="{loc:Loc dailyClose.linklySettlement.manual.hint}"
                                           Margin="0,3,0,8"
                                           FontSize="11"
                                           Foreground="#FF5F5A4D"
                                           TextWrapping="Wrap" />
                                <WrapPanel>
                                    <Button Command="{Binding PrepareSettlementManualResolutionCommand}"
                                            CommandParameter="{x:Static services:LocalLinklySettlementManualResolution.ConfirmedSucceeded}"
                                            MinHeight="32"
                                            Margin="0,0,6,6"
                                            Padding="10,4"
                                            IsTabStop="True"
                                            ToolTip="{loc:Loc dailyClose.linklySettlement.manual.keyboardHint}"
                                            AutomationProperties.Name="{loc:Loc dailyClose.linklySettlement.manual.succeeded}"
                                            Style="{StaticResource PosSecondaryButtonStyle}">
                                        <TextBlock Text="{loc:Loc dailyClose.linklySettlement.manual.succeeded}" />
                                    </Button>
                                    <Button Command="{Binding PrepareSettlementManualResolutionCommand}"
                                            CommandParameter="{x:Static services:LocalLinklySettlementManualResolution.ConfirmedFailed}"
                                            MinHeight="32"
                                            Margin="0,0,6,6"
                                            Padding="10,4"
                                            IsTabStop="True"
                                            ToolTip="{loc:Loc dailyClose.linklySettlement.manual.keyboardHint}"
                                            AutomationProperties.Name="{loc:Loc dailyClose.linklySettlement.manual.failed}"
                                            Style="{StaticResource PosSecondaryButtonStyle}">
                                        <TextBlock Text="{loc:Loc dailyClose.linklySettlement.manual.failed}" />
                                    </Button>
                                    <Button Command="{Binding PrepareSettlementManualResolutionCommand}"
                                            CommandParameter="{x:Static services:LocalLinklySettlementManualResolution.ConfirmedNotSubmitted}"
                                            MinHeight="32"
                                            Margin="0,0,6,6"
                                            Padding="10,4"
                                            IsTabStop="True"
                                            ToolTip="{loc:Loc dailyClose.linklySettlement.manual.keyboardHint}"
                                            AutomationProperties.Name="{loc:Loc dailyClose.linklySettlement.manual.notSubmitted}"
                                            Style="{StaticResource PosSecondaryButtonStyle}">
                                        <TextBlock Text="{loc:Loc dailyClose.linklySettlement.manual.notSubmitted}" />
                                    </Button>
                                </WrapPanel>
                                <Border Margin="0,4,0,0"
                                        Padding="9"
                                        Background="#FFFFFDF5"
                                        BorderBrush="#FFE0C56B"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Visibility="{Binding IsSettlementManualResolutionConfirmationVisible, Converter={StaticResource BoolToVis}}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding SettlementManualResolutionPrompt}"
                                                   FontSize="11"
                                                   TextWrapping="Wrap" />
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <Button Command="{Binding ConfirmSettlementManualResolutionCommand}"
                                                    MinHeight="32"
                                                    Padding="10,4"
                                                    IsTabStop="True"
                                                    ToolTip="{loc:Loc dailyClose.linklySettlement.manual.keyboardHint}"
                                                    AutomationProperties.Name="{loc:Loc dailyClose.linklySettlement.manual.confirm}"
                                                    Style="{StaticResource PosPrimaryButtonStyle}">
                                                <TextBlock Text="{loc:Loc dailyClose.linklySettlement.manual.confirm}" Foreground="White" />
                                            </Button>
                                            <Button Command="{Binding CancelSettlementManualResolutionCommand}"
                                                    MinHeight="32"
                                                    Margin="8,0,0,0"
                                                    Padding="10,4"
                                                    IsTabStop="True"
                                                    ToolTip="{loc:Loc dailyClose.linklySettlement.manual.keyboardHint}"
                                                    AutomationProperties.Name="{loc:Loc dailyClose.linklySettlement.manual.cancel}"
                                                    Style="{StaticResource PosSecondaryButtonStyle}">
                                                <TextBlock Text="{loc:Loc dailyClose.linklySettlement.manual.cancel}" />
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Button Grid.Row="2"
                                Command="{Binding ReprintSelectedSettlementCommand}"
                                Height="50"
                                Margin="0,14,0,0"
                                Style="{StaticResource PosPrimaryButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Printer" Width="18" Height="18" Margin="0,0,8,0" Foreground="White" />
                                <TextBlock Text="{loc:Loc dailyClose.linklySettlement.reprintSelected}" Foreground="White" FontWeight="Bold" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>

        <Grid x:Name="CashCountDialogOverlay"
              Panel.ZIndex="100"
              Background="#660F172A"
              Visibility="{Binding IsCashCountDialogOpen, Converter={StaticResource BoolToVis}}"
              IsVisibleChanged="CashCountDialogOverlayIsVisibleChanged"
              PreviewKeyDown="CashCountDialogOverlayPreviewKeyDown"
              FocusManager.IsFocusScope="True"
              KeyboardNavigation.TabNavigation="Cycle"
              KeyboardNavigation.ControlTabNavigation="None"
              AutomationProperties.AutomationId="DailyCloseCashCountDialog"
              AutomationProperties.Name="{loc:Loc dailyClose.cashCountDialog.automationName}">
            <Border Width="460"
                    MaxHeight="610"
                    Padding="24,20"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="White"
                    BorderBrush="#FFE2E2E6"
                    BorderThickness="1"
                    CornerRadius="16">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30"
                                      ShadowDepth="6"
                                      Opacity="0.22"
                                      Color="#FF101828" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center"
                                   FontSize="20"
                                   FontWeight="Black"
                                   Foreground="#FF191C1E">
                            <Run Text="{loc:Loc dailyClose.cashCountDialog.titlePrefix}" />
                            <Run Text=" " />
                            <Run Text="{Binding SelectedCashDenomination.Label, Mode=OneWay}" />
                        </TextBlock>
                        <Button Grid.Column="1"
                                Command="{Binding CancelCashCountDialogCommand}"
                                Width="40"
                                Height="40"
                                MinWidth="40"
                                MinHeight="40"
                                Padding="0"
                                ToolTip="{loc:Loc common.cancel}"
                                AutomationProperties.Name="{loc:Loc common.cancel}"
                                Style="{StaticResource PosSecondaryButtonStyle}">
                            <materialDesign:PackIcon Kind="Close" Width="20" Height="20" />
                        </Button>
                    </Grid>

                    <TextBlock Grid.Row="1"
                               Margin="0,5,0,0"
                               Foreground="#FF5F636E"
                               FontSize="12"
                               TextWrapping="Wrap">
                        <Run Text="{loc:Loc dailyClose.cashCountDialog.helperPrefix}" />
                        <Run Text=" " />
                        <Run Text="{Binding SelectedCashDenomination.Label, Mode=OneWay}" />
                        <Run Text=" " />
                        <Run Text="{loc:Loc dailyClose.cashCountDialog.helperSuffix}" />
                    </TextBlock>

                    <Border Grid.Row="2"
                            Margin="0,16,0,0"
                            Padding="14,10"
                            Background="#FFF7F9FC"
                            BorderBrush="#FFE2E2E6"
                            BorderThickness="1"
                            CornerRadius="10">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="{loc:Loc dailyClose.quantity}"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="#FF737785"
                                       HorizontalAlignment="Center" />
                            <Grid Margin="0,2,0,0">
                                <TextBlock Text="0"
                                           FontSize="34"
                                           FontWeight="Black"
                                           Foreground="#FF191C1E"
                                           HorizontalAlignment="Center"
                                           Visibility="{Binding KeypadBuffer, Converter={StaticResource StringIsEmptyToVis}}" />
                                <TextBlock Text="{Binding KeypadBuffer}"
                                           FontSize="34"
                                           FontWeight="Black"
                                           Foreground="#FF191C1E"
                                           HorizontalAlignment="Center"
                                           Visibility="{Binding KeypadBuffer, Converter={StaticResource StringHasValueToVis}}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Row="3" Margin="0,10,0,6" HorizontalAlignment="Center">
                        <TextBlock HorizontalAlignment="Center"
                                   FontSize="12"
                                   Foreground="#FF737785">
                            <Run Text="{Binding CashCountDialogQuantity, Mode=OneWay}" />
                            <Run Text=" × " />
                            <Run Text="{Binding SelectedCashDenomination.Label, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Text="{Binding CashCountDialogSubtotal, StringFormat={}{0:C2}}"
                                   Margin="0,2,0,0"
                                   HorizontalAlignment="Center"
                                   FontSize="27"
                                   FontWeight="Black"
                                   Foreground="#FF191C1E" />
                    </StackPanel>

                    <UniformGrid x:Name="CashCountNineGrid"
                                 Grid.Row="4"
                                 Rows="3"
                                 Columns="3">
                        <Button Style="{StaticResource KeypadButtonStyle}" Command="{Binding KeypadInputCommand}" CommandParameter="1" AutomationProperties.Name="1"><TextBlock Text="1" /></Button>
                        <Button Style="{StaticResource KeypadButtonStyle}" Command="{Binding KeypadInputCommand}" CommandParameter="2" AutomationProperties.Name="2"><TextBlock Text="2" /></Button>
                        <Button Style="{StaticResource KeypadButtonStyle}" Command="{Binding KeypadInputCommand}" CommandParameter="3" AutomationProperties.Name="3"><TextBlock Text="3" /></Button>
                        <Button Style="{StaticResource KeypadButtonStyle}" Command="{Binding KeypadInputCommand}" CommandParameter="4" AutomationProperties.Name="4"><TextBlock Text="4" /></Button>
                        <Button Style="{StaticResource KeypadButtonStyle}" Command="{Binding KeypadInputCommand}" CommandParameter="5" AutomationProperties.Name="5"><TextBlock Text="5" /></Button>
                        <Button Style="{StaticResource KeypadButtonStyle}" Command="{Binding KeypadInputCommand}" CommandParameter="6" AutomationProperties.Name="6"><TextBlock Text="6" /></Button>
                        <Button Style="{StaticResource KeypadButtonStyle}" Command="{Binding KeypadInputCommand}" CommandParameter="7" AutomationProperties.Name="7"><TextBlock Text="7" /></Button>
                        <Button Style="{StaticResource KeypadButtonStyle}" Command="{Binding KeypadInputCommand}" CommandParameter="8" AutomationProperties.Name="8"><TextBlock Text="8" /></Button>
                        <Button Style="{StaticResource KeypadButtonStyle}" Command="{Binding KeypadInputCommand}" CommandParameter="9" AutomationProperties.Name="9"><TextBlock Text="9" /></Button>
                    </UniformGrid>

                    <UniformGrid x:Name="CashCountUtilityRow"
                                 Grid.Row="5"
                                 Rows="1"
                                 Columns="3">
                        <Button Style="{StaticResource KeypadButtonStyle}"
                                Command="{Binding KeypadClearCommand}"
                                Background="#FFFFF3F2"
                                BorderBrush="#FFFFB4AB"
                                Foreground="#FF93000A"
                                FontSize="14"
                                AutomationProperties.Name="{loc:Loc dailyClose.cashCountDialog.clear}">
                            <TextBlock Text="{loc:Loc dailyClose.cashCountDialog.clear}" FontWeight="Bold" />
                        </Button>
                        <Button Style="{StaticResource KeypadButtonStyle}"
                                Command="{Binding KeypadInputCommand}"
                                CommandParameter="0"
                                AutomationProperties.Name="0">
                            <TextBlock Text="0" />
                        </Button>
                        <Button Style="{StaticResource KeypadButtonStyle}"
                                Command="{Binding KeypadBackspaceCommand}"
                                Background="#FFEAF2FF"
                                BorderBrush="#FF80A9E8"
                                Foreground="#FF0040A1"
                                AutomationProperties.Name="{loc:Loc dailyClose.cashCountDialog.backspace}">
                            <materialDesign:PackIcon Kind="BackspaceOutline" Width="24" Height="24" Foreground="#FF0040A1" />
                        </Button>
                    </UniformGrid>

                    <Grid Grid.Row="6" Margin="5,12,5,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="CashCountDialogCancelButton"
                                Grid.Column="0"
                                Command="{Binding CancelCashCountDialogCommand}"
                                Height="48"
                                Style="{StaticResource PosSecondaryButtonStyle}">
                            <TextBlock Text="{loc:Loc common.cancel}" FontWeight="Bold" />
                        </Button>
                        <Button Grid.Column="2"
                                Command="{Binding ApplyDenominationCommand}"
                                CommandParameter="{Binding SelectedCashDenomination}"
                                Height="48"
                                Style="{StaticResource PosPrimaryButtonStyle}">
                            <TextBlock Text="{loc:Loc dailyClose.cashCountDialog.apply}"
                                       Foreground="White"
                                       FontWeight="Bold" />
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
