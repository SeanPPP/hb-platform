                                                 Style="{StaticResource SettingsFieldTextBoxStyle}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{loc:Loc settings.receiptPrinter.brandName}" Style="{StaticResource SettingsLabelStyle}" />
                                        <TextBox Text="{Binding ReceiptBrandNameText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource SettingsFieldTextBoxStyle}" />
                                    </StackPanel>
                                </Grid>

                                <Grid Grid.Row="2" Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="14" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{loc:Loc settings.receiptPrinter.storeName}" Style="{StaticResource SettingsLabelStyle}" />
                                        <TextBox Text="{Binding ReceiptStoreNameText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource SettingsFieldTextBoxStyle}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{loc:Loc settings.receiptPrinter.phone}" Style="{StaticResource SettingsLabelStyle}" />
                                        <TextBox Text="{Binding ReceiptStorePhoneText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource SettingsFieldTextBoxStyle}" />
                                    </StackPanel>
                                </Grid>

                                <Grid Grid.Row="3" Margin="0,0,0,18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="14" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{loc:Loc settings.receiptPrinter.address}" Style="{StaticResource SettingsLabelStyle}" />
                                        <TextBox Text="{Binding ReceiptStoreAddressText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource SettingsFieldTextBoxStyle}"
                                                 Height="86"
                                                 TextWrapping="Wrap"
                                                 AcceptsReturn="True"
                                                 ScrollViewer.PanningMode="VerticalFirst"
                                                 VerticalScrollBarVisibility="Auto" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{loc:Loc settings.receiptPrinter.abn}" Style="{StaticResource SettingsLabelStyle}" />
                                        <TextBox Text="{Binding ReceiptAbnText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource SettingsFieldTextBoxStyle}"
                                                 Margin="0,0,0,14" />
                                        <TextBlock Text="{loc:Loc settings.receiptPrinter.returnPolicy}" Style="{StaticResource SettingsLabelStyle}" />
                                        <TextBox Text="{Binding ReceiptReturnPolicyText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource SettingsFieldTextBoxStyle}"
                                                 Height="86"
                                                 MaxLength="500"
                                                 TextWrapping="Wrap"
                                                 AcceptsReturn="True"
                                                 ScrollViewer.PanningMode="VerticalFirst"
                                                 VerticalScrollBarVisibility="Auto" />
                                    </StackPanel>
                                </Grid>

                                <DockPanel Grid.Row="4">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="18,0,0,0">
                                        <Button Command="{Binding TestReceiptPrinterCommand}"
                                                Style="{StaticResource PosSecondaryButtonStyle}"
                                                Height="42"
                                                MinWidth="138"
                                                Margin="0,0,10,0">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="Printer" Width="18" Height="18" Margin="0,0,8,0" />
                                                <TextBlock Text="{loc:Loc settings.receiptPrinter.test}" />
                                            </StackPanel>
                                        </Button>
                                        <Button Command="{Binding SaveReceiptPrinterCommand}"
                                                Style="{StaticResource PosPrimaryButtonStyle}"
                                                Height="42"
                                                MinWidth="138">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="ContentSave" Width="18" Height="18" Margin="0,0,8,0" Foreground="White" />
                                                <TextBlock Text="{loc:Loc settings.receiptPrinter.save}" Foreground="White" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                    <Border Background="#FFF6F8FB"
                                            BorderBrush="#FFE0E4EC"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="10,8">
                                        <TextBlock Text="{Binding ReceiptPrinterTestStatusMessage}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource PosMutedForegroundBrush}"
                                                   TextWrapping="Wrap" />
                                    </Border>
                                </DockPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Row="1"
                                Grid.Column="2"
                                Style="{StaticResource SettingsActionCardStyle}"
                                Padding="16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
                                    <materialDesign:PackIcon Kind="ReceiptTextOutline"
                                                             Width="22"
                                                             Height="22"
                                                             Foreground="{StaticResource PosPrimaryBrush}"
                                                             Margin="0,0,9,0" />
                                    <TextBlock Text="{loc:Loc settings.receiptPrinter.preview}"
                                               FontSize="15"
                                               FontWeight="Black"
                                               VerticalAlignment="Center" />
                                </StackPanel>

                                <Border Grid.Row="1"
                                        Background="#FFF4F6F9"
                                        BorderBrush="#FFE0E4EC"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="18">
                                    <Border Width="220"
                                            MinHeight="410"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Top"
                                            Background="#FFFFFFFF"
                                            Padding="18,24">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.18" Color="#FF64748B" />
                                        </Border.Effect>
                                        <StackPanel>
                                            <TextBlock Text="{Binding ReceiptBrandNameText}"
                                                       FontSize="19"
                                                       FontWeight="Black"
                                                       TextAlignment="Center"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding ReceiptStoreNameText}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       TextAlignment="Center"
                                                       TextWrapping="Wrap"
                                                       Margin="0,10,0,0" />
                                            <TextBlock Text="{Binding ReceiptStoreAddressText}"
                                                       FontSize="10"
                                                       Foreground="{StaticResource PosMutedForegroundBrush}"
                                                       TextAlignment="Center"
                                                       TextWrapping="Wrap"
                                                       Margin="0,6,0,0" />
                                            <TextBlock Text="{Binding ReceiptStorePhoneText}"
                                                       FontSize="10"
                                                       Foreground="{StaticResource PosMutedForegroundBrush}"
                                                       TextAlignment="Center"
                                                       TextWrapping="Wrap"
                                                       Margin="0,4,0,0" />
                                            <TextBlock Text="{Binding ReceiptAbnText}"
                                                       FontSize="10"
                                                       Foreground="{StaticResource PosMutedForegroundBrush}"
                                                       TextAlignment="Center"
                                                       TextWrapping="Wrap"
                                                       Margin="0,4,0,0" />
                                            <Border BorderBrush="#FF9AA4B2"
                                                    BorderThickness="0,1,0,0"
                                                    Margin="0,20,0,18" />
                                            <TextBlock Text="{loc:Loc settings.receiptPrinter.test}"
                                                       FontSize="15"
                                                       FontWeight="Black"
                                                       TextAlignment="Center" />
                                            <Border BorderBrush="#FF9AA4B2"
                                                    BorderThickness="0,1,0,0"
                                                    Margin="0,18,0,18" />
                                            <TextBlock Text="{Binding ReceiptReturnPolicyText}"
                                                       FontSize="10"
                                                       Foreground="{StaticResource PosMutedForegroundBrush}"
                                                       TextAlignment="Center"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>

                    <Grid Visibility="{Binding IsDeviceRegistrationSelected, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.05*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Row="0"
                                Grid.ColumnSpan="3"
                                Style="{StaticResource SettingsActionCardStyle}"
                                Margin="0,0,0,16">
                            <DockPanel>
                                <Border DockPanel.Dock="Right"
                                        Background="#FFE8F7F1"
                                        CornerRadius="8"
                                        Padding="12,8"
                                        Margin="18,0,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="CheckCircleOutline"
                                                                 Width="19"
                                                                 Height="19"
                                                                 Foreground="#FF0A8F55"
                                                                 Margin="0,0,7,0" />
                                        <TextBlock Text="{loc:Loc settings.deviceRegistration.active}"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   Foreground="#FF0A8F55"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                                <Border DockPanel.Dock="Left"
                                        Width="58"
                                        Height="58"
                                        Background="#FFEAF2FF"
                                        CornerRadius="10"
                                        Margin="0,0,18,0">
                                    <materialDesign:PackIcon Kind="CashRegister"
                                                             Width="34"
                                                             Height="34"
                                                             Foreground="{StaticResource PosPrimaryBrush}"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Center" />
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{loc:Loc settings.deviceRegistration.current}"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource PosMutedForegroundBrush}" />
                                    <TextBlock FontSize="21"
                                               FontWeight="Black"
                                               Foreground="{StaticResource PosTextBrush}"
                                               Margin="0,3,0,0">
                                        <Run Text="{Binding Session.StoreName, Mode=OneWay}" />
                                        <Run Text=" (" />
                                        <Run Text="{Binding Session.StoreCode, Mode=OneWay}" />
                                        <Run Text=")" />
                                    </TextBlock>
                                    <TextBlock FontSize="11"
                                               Foreground="{StaticResource PosMutedForegroundBrush}"
                                               Margin="0,4,0,0">
                                        <Run Text="{loc:Loc settings.deviceRegistration.thisDevice}" />
                                        <Run Text=": " />
                                        <Run Text="{Binding Session.DeviceCode, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <controls:ApiServerSettingsPanel DataContext="{Binding ApiServerSettings}"
                                                         Grid.Row="1"
                                                         Grid.Column="0" />

                        <Border Grid.Row="1"
                                Grid.Column="2"
                                Style="{StaticResource SettingsActionCardStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0">
                                    <TextBlock Text="{Binding DeviceRegistrationTitleText}"
                                               FontSize="18"
                                               FontWeight="Black"
                                               Foreground="{StaticResource PosTextBrush}" />
                                    <TextBlock Text="{loc:Loc settings.deviceRegistration.description}"
                                               Style="{StaticResource SettingsPageDescriptionStyle}" />
                                </StackPanel>

                                <Border Grid.Row="1"
                                        Background="#FFFFF7E8"
                                        BorderBrush="#FFFFD59B"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="14,12"
                                        Margin="0,18,0,18">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="30" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <materialDesign:PackIcon Grid.Column="0"
                                                                 Kind="ShieldAccountOutline"
                                                                 Width="20"
                                                                 Height="20"
                                                                 Foreground="#FFEF8A00"
                                                                 VerticalAlignment="Top" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{loc:Loc settings.deviceRegistration.supervisorRequired}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="#FF7A4A00"
                                                   TextWrapping="Wrap" />
                                    </Grid>
                                </Border>

                                <StackPanel Grid.Row="2" Margin="0,0,0,18">
                                    <TextBlock Text="{loc:Loc settings.deviceRegistration.beforeContinue}"
                                               FontSize="13"
                                               FontWeight="Black"
                                               Margin="0,0,0,12" />
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <materialDesign:PackIcon Kind="Cart" Width="20" Height="20" Foreground="{StaticResource PosPrimaryBrush}" Margin="0,0,10,0" />
                                        <TextBlock Text="{loc:Loc settings.deviceRegistration.checkCart}"
                                                   FontSize="11"
                                                   Foreground="{StaticResource PosMutedForegroundBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <materialDesign:PackIcon Kind="CreditCard" Width="20" Height="20" Foreground="{StaticResource PosPrimaryBrush}" Margin="0,0,10,0" />
                                        <TextBlock Text="{loc:Loc settings.deviceRegistration.checkPayment}"
                                                   FontSize="11"
                                                   Foreground="{StaticResource PosMutedForegroundBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Sync" Width="20" Height="20" Foreground="{StaticResource PosPrimaryBrush}" Margin="0,0,10,0" />
                                        <TextBlock Text="{loc:Loc settings.deviceRegistration.checkSync}"
                                                   FontSize="11"
                                                   Foreground="{StaticResource PosMutedForegroundBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Row="3">
                                    <Button Command="{Binding ReregisterDeviceCommand}"
                                            Style="{StaticResource PosPrimaryButtonStyle}"
                                            Height="46"
                                            HorizontalAlignment="Stretch">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="AccountSwitch" Width="18" Height="18" Margin="0,0,8,0" Foreground="White" />
                                            <TextBlock Text="{loc:Loc settings.deviceRegistration.action}" Foreground="White" />
                                        </StackPanel>
                                    </Button>
                                    <TextBlock Text="{loc:Loc settings.deviceRegistration.deviceReuse}"
                                               FontSize="10"
                                               Foreground="{StaticResource PosMutedForegroundBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,10,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="2"
                Background="#FFFAFAFA"
                BorderBrush="#FFE1E5EC"
                BorderThickness="0,1,0,0"
                Padding="24,10">
            <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Kind="InformationOutline"
                                         Width="16"
                                         Height="16"
                                         Foreground="{StaticResource PosMutedForegroundBrush}"
                                         Margin="0,0,8,0" />
                <TextBlock Text="{Binding StatusMessage}"
                           FontSize="12"
                           Foreground="{StaticResource PosMutedForegroundBrush}"
                           TextTrimming="CharacterEllipsis" />
                <ProgressBar Width="90"
                             Height="4"
                             Margin="14,0,0,0"
                             IsIndeterminate="True"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
        </Border>

        <Border Grid.RowSpan="3"
                Background="#99000000"
                Visibility="{Binding IsLinklySetupInstructionsOpen, Converter={StaticResource BoolToVis}}">
            <Grid Margin="24">
                <Border Width="720"
                        MaxHeight="560"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="{StaticResource PosSurfaceBrush}"
                        BorderBrush="#FFE0E4EC"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="22">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0,0,0,16">
                            <Button DockPanel.Dock="Right"
                                    Command="{Binding CloseLinklySetupInstructionsCommand}"
                                    Style="{StaticResource PosSecondaryButtonStyle}"
                                    Width="38"
                                    Height="38"
                                    Padding="0">
                                <materialDesign:PackIcon Kind="Close"
                                                         Width="18"
                                                         Height="18"
                                                         HorizontalAlignment="Center"
                                                         VerticalAlignment="Center" />
                            </Button>
                            <StackPanel>
                                <TextBlock Text="{loc:Loc settings.linkly.sop.title}"
                                           FontSize="18"
                                           FontWeight="Black"
                                           Foreground="{StaticResource PosTextBrush}" />
                                <TextBlock Text="{loc:Loc settings.linkly.sop.note}"
                                           FontSize="12"
                                           Foreground="{StaticResource PosMutedForegroundBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,4,16,0" />
                            </StackPanel>
                        </DockPanel>

                        <ScrollViewer Grid.Row="1"
                                      Style="{StaticResource PosVerticalTouchScrollViewerStyle}"
                                      VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="{loc:Loc settings.linkly.sop.cloud.title}"
                                           Style="{StaticResource SettingsLabelStyle}" />
                                <TextBlock Text="{loc:Loc settings.linkly.sop.cloud.step1}"
                                           FontFamily="Consolas"
                                           FontSize="12"
                                           Foreground="{StaticResource PosTextBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,5" />
                                <TextBlock Text="{loc:Loc settings.linkly.sop.cloud.step2}"
                                           FontSize="12"
                                           Foreground="{StaticResource PosMutedForegroundBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,5" />
                                <TextBlock Text="{loc:Loc settings.linkly.sop.cloud.step3}"
                                           FontSize="12"
                                           Foreground="{StaticResource PosMutedForegroundBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,5" />
                                <TextBlock Text="{loc:Loc settings.linkly.sop.cloud.step4}"
                                           FontSize="12"
                                           Foreground="{StaticResource PosMutedForegroundBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,5" />
                                <TextBlock Text="{loc:Loc settings.linkly.sop.cloud.step5}"
                                           FontSize="12"
                                           Foreground="{StaticResource PosMutedForegroundBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,5" />
                                <TextBlock Text="{loc:Loc settings.linkly.sop.cloud.step6}"
                                           FontSize="12"
                                           Foreground="{StaticResource PosMutedForegroundBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,5" />
                                <TextBlock Text="{loc:Loc settings.linkly.sop.cloud.step7}"
                                           FontSize="12"
                                           Foreground="{StaticResource PosMutedForegroundBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,5" />
                                <TextBlock Text="{loc:Loc settings.linkly.sop.cloud.step8}"
                                           FontSize="12"
                                           Foreground="{StaticResource PosMutedForegroundBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,16" />

                                <TextBlock Text="{loc:Loc settings.linkly.sop.repair.title}"
                                           Style="{StaticResource SettingsLabelStyle}" />
                                <TextBlock Text="{loc:Loc settings.linkly.sop.repair.step1}"
                                           FontFamily="Consolas"
                                           FontSize="12"
                                           Foreground="{StaticResource PosTextBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,5" />
                                <TextBlock Text="{loc:Loc settings.linkly.sop.repair.step2}"
                                           FontSize="12"
                                           Foreground="{StaticResource PosMutedForegroundBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,5" />
                                <TextBlock Text="{loc:Loc settings.linkly.sop.repair.step3}"
                                           FontSize="12"
                                           Foreground="{StaticResource PosMutedForegroundBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,5" />
                                <TextBlock Text="{loc:Loc settings.linkly.sop.repair.warning}"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource PosDangerBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,16" />

                                <TextBlock Text="{loc:Loc settings.linkly.sop.local.title}"
                                           Style="{StaticResource SettingsLabelStyle}" />
                                <TextBlock Text="{loc:Loc settings.linkly.sop.local.step1}"
                                           FontFamily="Consolas"
                                           FontSize="12"
                                           Foreground="{StaticResource PosTextBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,5" />
                                <TextBlock Text="{loc:Loc settings.linkly.sop.local.step2}"
                                           FontFamily="Consolas"
                                           FontSize="12"
                                           Foreground="{StaticResource PosTextBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,5" />
                                <TextBlock Text="{loc:Loc settings.linkly.sop.local.step3}"
                                           FontSize="12"
                                           Foreground="{StaticResource PosMutedForegroundBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,5" />
                                <TextBlock Text="{loc:Loc settings.linkly.sop.local.step4}"
                                           FontSize="12"
                                           Foreground="{StaticResource PosMutedForegroundBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,5" />
                                <TextBlock Text="{loc:Loc settings.linkly.sop.local.step5}"
                                           FontSize="12"
                                           Foreground="{StaticResource PosMutedForegroundBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,5" />
                                <TextBlock Text="{loc:Loc settings.linkly.sop.local.step6}"
                                           FontSize="12"
                                           Foreground="{StaticResource PosMutedForegroundBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,5" />
                                <TextBlock Text="{loc:Loc settings.linkly.sop.local.step7}"
                                           FontSize="12"
                                           Foreground="{StaticResource PosMutedForegroundBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,5" />
                                <TextBlock Text="{loc:Loc settings.linkly.sop.local.step8}"
                                           FontSize="12"
                                           Foreground="{StaticResource PosMutedForegroundBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,5" />
                                <TextBlock Text="{loc:Loc settings.linkly.sop.local.step9}"
                                           FontSize="12"
                                           Foreground="{StaticResource PosMutedForegroundBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,5" />
                                <TextBlock Text="{loc:Loc settings.linkly.sop.local.step10}"
                                           FontSize="12"
                                           Foreground="{StaticResource PosMutedForegroundBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,5" />
                                <TextBlock Text="{loc:Loc settings.linkly.sop.local.step11}"
                                           FontSize="12"
                                           Foreground="{StaticResource PosMutedForegroundBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,16" />

                                <TextBlock Text="{loc:Loc settings.linkly.sop.manual.title}"
                                           Style="{StaticResource SettingsLabelStyle}" />
                                <TextBlock Text="{loc:Loc settings.linkly.sop.manual.steps}"
                                           FontSize="12"
                                           Foreground="{StaticResource PosMutedForegroundBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,5" />
                                <TextBlock Text="{loc:Loc settings.linkly.sop.manual.warning}"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource PosDangerBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,16" />

                                <TextBlock Text="{loc:Loc settings.linkly.sop.ip.title}"
                                           Style="{StaticResource SettingsLabelStyle}" />
                                <TextBlock Text="{loc:Loc settings.linkly.sop.ip.steps}"
                                           FontSize="12"
                                           Foreground="{StaticResource PosMutedForegroundBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,5" />
                                <TextBlock Text="{loc:Loc settings.linkly.sop.ip.note}"
                                           FontSize="12"
                                           Foreground="{StaticResource PosMutedForegroundBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,16" />

                                <TextBlock Text="{loc:Loc settings.linkly.sop.mode.title}"
                                           Style="{StaticResource SettingsLabelStyle}" />
                                <TextBlock Text="{loc:Loc settings.linkly.sop.mode.localIp}"
                                           FontSize="12"
                                           Foreground="{StaticResource PosMutedForegroundBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,5" />
                                <TextBlock Text="{loc:Loc settings.linkly.sop.mode.cloudDirectSync}"
                                           FontSize="12"
                                           Foreground="{StaticResource PosMutedForegroundBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,5" />
                                <TextBlock Text="{loc:Loc settings.linkly.sop.mode.cloudBackendAsync}"
                                           FontSize="12"
                                           Foreground="{StaticResource PosMutedForegroundBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </ScrollViewer>

                        <Button Grid.Row="2"
                                Command="{Binding CloseLinklySetupInstructionsCommand}"
                                Style="{StaticResource PosPrimaryButtonStyle}"
                                Height="42"
                                MinWidth="110"
                                HorizontalAlignment="Right"
                                Margin="0,16,0,0">
                            <TextBlock Text="{loc:Loc settings.linkly.sop.close}" Foreground="White" />
                        </Button>
                    </Grid>
                </Border>
            </Grid>
