<UserControl x:Class="Hbpos.Client.Wpf.Views.Screens.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:Hbpos.Client.Wpf.Converters"
             xmlns:controls="clr-namespace:Hbpos.Client.Wpf.Views.Controls"
             xmlns:loc="clr-namespace:Hbpos.Client.Wpf.Localization"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:services="clr-namespace:Hbpos.Client.Wpf.Services"
             mc:Ignorable="d"
             d:DesignHeight="688"
             d:DesignWidth="1366"
             FontFamily="Segoe UI"
             Background="{StaticResource PosScreenBackgroundBrush}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:LocalizationKeyConverter x:Key="LocalizationKeyConverter" />

        <Style x:Key="SettingsLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource PosMutedForegroundBrush}" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <!-- 单行输入框不接管触摸平移，让设置页外层 ScrollViewer 处理纵向拖动。 -->
        <Style x:Key="SettingsFieldTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource PosSearchTextBoxStyle}">
            <Setter Property="Height" Value="42" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="ScrollViewer.PanningMode" Value="None" />
        </Style>

        <Style x:Key="SettingsFieldPasswordBoxStyle" TargetType="PasswordBox">
            <Setter Property="Height" Value="42" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource PosBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="ScrollViewer.PanningMode" Value="None" />
        </Style>

        <Style x:Key="SettingsComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource PosBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="SettingsCategoryButtonStyle" TargetType="Button" BasedOn="{StaticResource PosSecondaryButtonStyle}">
            <Setter Property="Height" Value="64" />
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="BorderThickness" Value="1" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="True">
                    <Setter Property="Background" Value="#FFEAF2FF" />
                    <Setter Property="BorderBrush" Value="{StaticResource PosPrimaryBrush}" />
                    <Setter Property="BorderThickness" Value="4,1,1,1" />
                    <Setter Property="Foreground" Value="{StaticResource PosPrimaryBrush}" />
                    <Setter Property="Padding" Value="15,0,18,0" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SettingsActionCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PosSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="#FFE0E4EC" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="20" />
        </Style>

        <Style x:Key="SettingsPageTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="Black" />
            <Setter Property="Foreground" Value="{StaticResource PosTextBrush}" />
        </Style>

        <Style x:Key="SettingsPageDescriptionStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource PosMutedForegroundBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>

        <Style x:Key="SettingsContextBadgeStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFFFF" />
            <Setter Property="BorderBrush" Value="{StaticResource PosBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14,9" />
        </Style>

        <Style x:Key="SettingsProviderTabStyle" TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource PosTextBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,0,12,14" />
            <Setter Property="MinHeight" Value="48" />
            <Setter Property="MinWidth" Value="220" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="ProviderTabBorder"
                                Background="#FFFFFFFF"
                                BorderBrush="{StaticResource PosBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="18,12">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ProviderTabBorder" Property="Background" Value="#FFEAF2FF" />
                                <Setter TargetName="ProviderTabBorder" Property="BorderBrush" Value="{StaticResource PosPrimaryBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource PosPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ProviderTabBorder" Property="BorderBrush" Value="{StaticResource PosPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsModeChoiceBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFFFF" />
            <Setter Property="BorderBrush" Value="#FFE0E4EC" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10,7" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                             Value="True">
                    <Setter Property="Background" Value="#FFEAF2FF" />
                    <Setter Property="BorderBrush" Value="{StaticResource PosPrimaryBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource PosSurfaceBrush}"
                BorderBrush="#FFE1E5EC"
                BorderThickness="0,0,0,1"
                Padding="24,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0"
                        Command="{Binding BackCommand}"
                        Style="{StaticResource PosSecondaryButtonStyle}"
                        Height="44">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ArrowLeft" Width="18" Height="18" Margin="0,0,8,0" />
                        <TextBlock Text="{loc:Loc shell.backToPos}" />
                    </StackPanel>
                </Button>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ScreenTitleText}"
                               FontSize="12"
                               Foreground="{StaticResource PosMutedForegroundBrush}" />
                    <TextBlock Text="/" Margin="12,0" FontSize="12" Foreground="#FF9AA4B2" />
                    <TextBlock Text="{Binding SettingsSubtitleText}"
                               FontSize="12"
                               Foreground="{StaticResource PosMutedForegroundBrush}" />
                </StackPanel>
                <Border Grid.Column="3"
                        Style="{StaticResource SettingsContextBadgeStyle}">
                    <Grid>
                        <StackPanel Orientation="Horizontal"
                                    Visibility="{Binding IsDataMaintenanceSelected, Converter={StaticResource BoolToVis}}">
                            <materialDesign:PackIcon Kind="DatabaseSyncOutline" Width="18" Height="18" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding DataMaintenanceTitleText}" FontWeight="Bold" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal"
                                    Visibility="{Binding IsPaymentTerminalSelected, Converter={StaticResource BoolToVis}}">
                            <materialDesign:PackIcon Kind="ContactlessPayment" Width="18" Height="18" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding CardTerminalTitleText}" FontWeight="Bold" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal"
                                    Visibility="{Binding IsReceiptPrinterSelected, Converter={StaticResource BoolToVis}}">
                            <materialDesign:PackIcon Kind="Printer" Width="18" Height="18" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding ReceiptPrinterTitleText}" FontWeight="Bold" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal"
                                    Visibility="{Binding IsDeviceRegistrationSelected, Converter={StaticResource BoolToVis}}">
                            <materialDesign:PackIcon Kind="ServerNetwork" Width="18" Height="18" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding DeviceRegistrationTitleText}" FontWeight="Bold" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="272" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 导航先于内容声明，使键盘 Tab 顺序与左到右的视觉顺序一致。 -->
            <Border Grid.Column="0"
                    Background="{StaticResource PosSurfaceBrush}"
                    BorderBrush="#FFE0E4EC"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="16">
                <StackPanel>
                    <TextBlock Text="{loc:Loc settings.category.title}"
                               FontSize="13"
                               FontWeight="Black"
                               Foreground="{StaticResource PosTextBrush}"
                               Margin="2,0,0,12" />

                    <Button Command="{Binding SelectDataMaintenanceCommand}"
                            Tag="{Binding IsDataMaintenanceSelected}"
                            Style="{StaticResource SettingsCategoryButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="DatabaseSyncOutline"
                                                     Width="21"
                                                     Height="21"
                                                     Margin="0,0,12,0"
                                                     Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
                            <TextBlock Text="{Binding DataMaintenanceTitleText}"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"
                                       Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding SelectPaymentTerminalCommand}"
                            Tag="{Binding IsPaymentTerminalSelected}"
                            Style="{StaticResource SettingsCategoryButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ContactlessPayment"
                                                     Width="21"
                                                     Height="21"
                                                     Margin="0,0,12,0"
                                                     Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
                            <TextBlock Text="{loc:Loc settings.category.paymentTerminal}"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"
                                       Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding SelectReceiptPrinterCommand}"
                            Tag="{Binding IsReceiptPrinterSelected}"
                            Style="{StaticResource SettingsCategoryButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Printer"
                                                     Width="21"
                                                     Height="21"
                                                     Margin="0,0,12,0"
                                                     Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
                            <TextBlock Text="{loc:Loc settings.category.receiptPrinter}"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"
                                       Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding SelectDeviceRegistrationCommand}"
                            Tag="{Binding IsDeviceRegistrationSelected}"
                            Style="{StaticResource SettingsCategoryButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CashRegister"
                                                     Width="21"
                                                     Height="21"
                                                     Margin="0,0,12,0"
                                                     Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
                            <TextBlock Text="{loc:Loc settings.category.deviceRegistrationNav}"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"
                                       Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- 启用 WPF 原生垂直触摸平移和惯性，保留鼠标滚轮及子控件点击行为。 -->
            <ScrollViewer Grid.Column="2"
                          Style="{StaticResource PosVerticalTouchScrollViewerStyle}"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          CanContentScroll="False"
                          PanningMode="VerticalOnly"
                          PanningDeceleration="0.0008"
                          PanningRatio="1.0">
                <Grid>
                    <Grid Visibility="{Binding IsDataMaintenanceSelected, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.2*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Row="0" Grid.ColumnSpan="3" Margin="10,2,0,18">
                            <TextBlock Text="{Binding DataMaintenanceTitleText}"
                                       Style="{StaticResource SettingsPageTitleStyle}" />
                            <TextBlock Text="{loc:Loc settings.page.dataMaintenance.description}"
                                       Style="{StaticResource SettingsPageDescriptionStyle}" />
                        </StackPanel>

                        <Border Grid.Row="1"
                                Grid.Column="0"
                                Style="{StaticResource SettingsActionCardStyle}"
                                MinHeight="208">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="72" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon Grid.Column="0"
                                                             Kind="CloudDownloadOutline"
                                                             Width="48"
                                                             Height="48"
                                                             Foreground="{StaticResource PosPrimaryBrush}"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Top" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{loc:Loc settings.section.dataDownload.title}"
                                                   FontSize="18"
                                                   FontWeight="Black"
                                                   Foreground="{StaticResource PosTextBrush}" />
                                        <TextBlock Text="{loc:Loc settings.section.dataDownload.description}"
                                                   Style="{StaticResource SettingsPageDescriptionStyle}" />
                                    </StackPanel>
                                </Grid>
                                <Button Grid.Row="1"
                                        Command="{Binding DownloadCatalogCommand}"
                                        services:ButtonFeedback.Cue="Download"
                                        Style="{StaticResource PosPrimaryButtonStyle}"
                                        Height="42"
                                        MinWidth="138"
                                        HorizontalAlignment="Left"
                                        Margin="72,14,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="CloudDownloadOutline" Width="18" Height="18" Margin="0,0,8,0" Foreground="White" />
                                        <TextBlock Text="{loc:Loc settings.section.dataDownload.action}" Foreground="White" />
                                    </StackPanel>
                                </Button>
                                <Border Grid.Row="3"
                                        Background="#FFF6F8FB"
                                        BorderBrush="#FFE0E4EC"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="12,10"
                                        Margin="0,16,0,0">
                                    <StackPanel>
                                        <TextBlock Text="{Binding StatusMessage}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource PosMutedForegroundBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <ProgressBar Height="4"
                                                     Margin="0,9,0,0"
                                                     IsIndeterminate="True"
                                                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <Border Grid.Row="1"
                                Grid.Column="2"
                                Style="{StaticResource SettingsActionCardStyle}"
                                MinHeight="208">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="72" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon Grid.Column="0"
                                                             Kind="DatabaseRefreshOutline"
                                                             Width="48"
                                                             Height="48"
                                                             Foreground="#FFEF8A00"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Top" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{loc:Loc settings.section.dataReset.title}"
                                                   FontSize="18"
                                                   FontWeight="Black"
                                                   Foreground="{StaticResource PosTextBrush}" />
                                        <TextBlock Text="{loc:Loc settings.section.dataReset.description}"
                                                   Style="{StaticResource SettingsPageDescriptionStyle}" />
                                    </StackPanel>
                                </Grid>
                                <Button Grid.Row="2"
                                        Command="{Binding ResetCatalogCommand}"
                                        Style="{StaticResource PosSecondaryButtonStyle}"
                                        Height="42"
                                        MinWidth="154"
                                        HorizontalAlignment="Center"
                                        Margin="0,18,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="DatabaseRefreshOutline" Width="18" Height="18" Margin="0,0,8,0" />
                                        <TextBlock Text="{loc:Loc settings.section.dataReset.action}" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>

                        <Border Grid.Row="2"
                                Grid.ColumnSpan="3"
                                Style="{StaticResource SettingsActionCardStyle}"
                                Margin="0,16,0,0">
                            <DockPanel>
                                <Border DockPanel.Dock="Left"
                                        Width="52"
                                        Height="52"
                                        Background="#FFE8F7F1"
                                        CornerRadius="10"
                                        Margin="0,0,16,0">
                                    <materialDesign:PackIcon Kind="Update"
                                                             Width="28"
                                                             Height="28"
                                                             Foreground="#FF047857"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Center" />
                                </Border>
                                <Button DockPanel.Dock="Right"
                                        Command="{Binding CheckForAppUpdateCommand}"
                                        Style="{StaticResource PosSecondaryButtonStyle}"
                                        Height="42"
                                        MinWidth="154"
                                        Margin="18,0,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Update" Width="18" Height="18" Margin="0,0,8,0" />
                                        <TextBlock Text="{loc:Loc settings.section.appUpdate.action}" />
                                    </StackPanel>
                                </Button>
                                <StackPanel>
                                    <TextBlock Text="{loc:Loc settings.section.appUpdate.title}"
                                               FontSize="18"
                                               FontWeight="Black"
                                               Foreground="{StaticResource PosTextBrush}" />
                                    <TextBlock Text="{loc:Loc settings.section.appUpdate.description}"
                                               Style="{StaticResource SettingsPageDescriptionStyle}" />
                                    <TextBlock FontSize="11"
                                               Foreground="{StaticResource PosMutedForegroundBrush}"
                                               Margin="0,5,0,0">
                                        <Run Text="{loc:Loc settings.section.appUpdate.channel}" />
                                        <Run Text=": " />
                                        <Run Text="{Binding AppUpdateChannelText, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <Border Grid.Row="3"
                                Grid.ColumnSpan="3"
                                Style="{StaticResource SettingsActionCardStyle}"
                                Background="#FFFFF7F7"
                                BorderBrush="#FFFFCCCC"
                                Margin="0,16,0,0"
                                Visibility="{Binding IsDebugTestSalesDataResetVisible, Converter={StaticResource BoolToVis}}">
                            <DockPanel>
                                <Border DockPanel.Dock="Left"
                                        Width="52"
                                        Height="52"
                                        Background="#FFFFE5E5"
                                        CornerRadius="10"
                                        Margin="0,0,16,0">
                                    <materialDesign:PackIcon Kind="DeleteOutline"
                                                             Width="28"
                                                             Height="28"
                                                             Foreground="#FFB42318"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Center" />
                                </Border>
                                <Button DockPanel.Dock="Right"
                                        Command="{Binding ResetTestSalesDataCommand}"
                                        services:ButtonFeedback.Cue="Delete"
                                        Style="{StaticResource PosSecondaryButtonStyle}"
                                        Height="42"
                                        MinWidth="168"
                                        Margin="18,0,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="DeleteOutline" Width="18" Height="18" Margin="0,0,8,0" Foreground="#FFB42318" />
                                        <TextBlock Text="{loc:Loc settings.section.testSalesDataReset.action}" Foreground="#FFB42318" />
                                    </StackPanel>
                                </Button>
                                <StackPanel>
                                    <TextBlock Text="{loc:Loc settings.section.testSalesDataReset.title}"
                                               FontSize="18"
                                               FontWeight="Black"
                                               Foreground="#FFB42318" />
                                    <TextBlock Text="{loc:Loc settings.section.testSalesDataReset.description}"
                                               Style="{StaticResource SettingsPageDescriptionStyle}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </Grid>

                    <Grid Visibility="{Binding IsPaymentTerminalSelected, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Row="0" Grid.ColumnSpan="3" Margin="10,2,0,18">
                            <TextBlock Text="{Binding CardTerminalTitleText}"
                                       Style="{StaticResource SettingsPageTitleStyle}" />
                            <TextBlock Text="{loc:Loc settings.page.paymentTerminal.description}"
                                       Style="{StaticResource SettingsPageDescriptionStyle}" />
                        </StackPanel>

                        <Border Grid.Row="1"
                                Grid.Column="0"
                                Grid.ColumnSpan="3"
                                Background="#FFFFFFFF"
                                BorderBrush="{StaticResource PosBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="20,16"
                                Margin="0,0,0,16">
                            <DockPanel>
                                <Border DockPanel.Dock="Left"
                                        Width="44"
                                        Height="44"
                                        Background="#FFEAF2FF"
                                        CornerRadius="8"
                                        Margin="0,0,14,0">
                                    <materialDesign:PackIcon Kind="ContactlessPayment"
                                                             Width="24"
                                                             Height="24"
                                                             Foreground="{StaticResource PosPrimaryBrush}"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Center" />
                                </Border>
                                <StackPanel>
                                    <TextBlock Text="{loc:Loc settings.payment.activeProvider.title}"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource PosMutedForegroundBrush}" />
                                    <TextBlock Text="{Binding ActivePaymentProviderText}"
                                               FontSize="18"
                                               FontWeight="Black"
                                               Margin="0,2,0,0" />
                                    <TextBlock Text="{Binding ActivePaymentProviderDetailText}"
                                               FontSize="12"
                                               Foreground="{StaticResource PosMutedForegroundBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <TabControl Grid.Row="2"
                                    Grid.ColumnSpan="3"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="0">
                            <TabControl.Resources>
                                <Style TargetType="TabItem" BasedOn="{StaticResource SettingsProviderTabStyle}" />
                            </TabControl.Resources>
                            <TabItem>
                                <TabItem.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="TabletCellphone" Width="20" Height="20" Margin="0,0,10,0" />
                                        <TextBlock Text="{Binding SquareTitleText}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </TabItem.Header>
                                <Border Style="{StaticResource SettingsActionCardStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <DockPanel Grid.Row="0" Margin="0,0,0,18">
                                    <Border DockPanel.Dock="Left"
                                            Width="38"
                                            Height="38"
                                            Background="#FFE8F0FE"
                                            CornerRadius="8"
                                            Margin="0,0,12,0">
                                        <materialDesign:PackIcon Kind="ContactlessPayment"
                                                                 Width="22"
