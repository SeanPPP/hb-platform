<UserControl x:Class="Hbpos.Client.Wpf.Views.Screens.TransactionHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:loc="clr-namespace:Hbpos.Client.Wpf.Localization"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Hbpos.Client.Wpf.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="688"
             d:DesignWidth="1366"
             Language="{Binding CurrentUiLanguage}"
             Background="#FFF5F7FA">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="HistoryPanelStyle" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#FFE2E8F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

        <Style x:Key="HistoryColumnHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#FFF8FAFC" />
            <Setter Property="Foreground" Value="#FF475569" />
            <Setter Property="FontSize" Value="{StaticResource PosFontSizeSmall}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="MinHeight" Value="48" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="BorderBrush" Value="#FFE2E8F0" />
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}"
                                   TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis"
                                   LineHeight="15"
                                   VerticalAlignment="Center" />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HistoryGridCellStyle" TargetType="DataGridCell">
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type DataGridCell}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#FFEFF6FF" />
                    <Setter Property="Foreground" Value="{StaticResource PosTextBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="HistoryPrimaryTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource PosTextBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="HistorySecondaryTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF64748B" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="HistoryRowStyle" TargetType="DataGridRow">
            <Setter Property="Height" Value="72" />
            <Setter Property="BorderBrush" Value="#FFE2E8F0" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#FFEFF6FF" />
                    <Setter Property="BorderBrush" Value="#FF93C5FD" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFF8FBFF" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="HistorySegmentRadioStyle" TargetType="RadioButton">
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="MinWidth" Value="84" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#FF334155" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RadioButton}">
                        <Border x:Name="Root"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="7"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource PosPrimaryBrush}" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource PosPrimaryBrush}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="False" />
                                    <Condition Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Root" Property="Background" Value="#FFF8FAFC" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="#FFCBD5E1" />
                            </MultiTrigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource PosPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HeldScopeSegmentRadioStyle" TargetType="RadioButton"
               BasedOn="{StaticResource HistorySegmentRadioStyle}">
            <!-- 与来源导航保持一致，避免 Held 模式切换时产生尺寸跳动。 -->
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="MinWidth" Value="88" />
            <Setter Property="Padding" Value="12,0" />
        </Style>

        <Style x:Key="HistoryFilterLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF64748B" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="2,0,0,5" />
        </Style>

        <Style x:Key="HistoryStatusBadgeBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFE7F7EF" />
            <Setter Property="BorderBrush" Value="#FFBBF7D0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSuspendedOrder}" Value="True">
                    <Setter Property="Background" Value="#FFFFF7ED" />
                    <Setter Property="BorderBrush" Value="#FFFED7AA" />
                </DataTrigger>
                <DataTrigger Binding="{Binding CanContinueInstallmentPayment}" Value="True">
                    <Setter Property="Background" Value="#FFEFF6FF" />
                    <Setter Property="BorderBrush" Value="#FFBFDBFE" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HeldBadgeKind}" Value="{x:Static vm:HeldOrderBadgeKind.LocalHold}">
                    <Setter Property="Background" Value="#FFFFF7ED" />
                    <Setter Property="BorderBrush" Value="#FFFED7AA" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HeldBadgeKind}" Value="{x:Static vm:HeldOrderBadgeKind.LocalPendingPublish}">
                    <Setter Property="Background" Value="#FFFFF7ED" />
                    <Setter Property="BorderBrush" Value="#FFFED7AA" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HeldBadgeKind}" Value="{x:Static vm:HeldOrderBadgeKind.Published}">
                    <Setter Property="Background" Value="#FFE7F7EF" />
                    <Setter Property="BorderBrush" Value="#FFBBF7D0" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HeldBadgeKind}" Value="{x:Static vm:HeldOrderBadgeKind.RemotePending}">
                    <Setter Property="Background" Value="#FFEFF6FF" />
                    <Setter Property="BorderBrush" Value="#FFBFDBFE" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HeldBadgeKind}" Value="{x:Static vm:HeldOrderBadgeKind.LocalClaimPrepared}">
                    <Setter Property="Background" Value="#FFF5F3FF" />
                    <Setter Property="BorderBrush" Value="#FFDDD6FE" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HeldBadgeKind}" Value="{x:Static vm:HeldOrderBadgeKind.LocalClaimActive}">
                    <Setter Property="Background" Value="#FFCCFBF1" />
                    <Setter Property="BorderBrush" Value="#FF5EEAD4" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HeldBadgeKind}" Value="{x:Static vm:HeldOrderBadgeKind.ClaimedByOther}">
                    <Setter Property="Background" Value="#FFF1F5F9" />
                    <Setter Property="BorderBrush" Value="#FFCBD5E1" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HeldBadgeKind}" Value="{x:Static vm:HeldOrderBadgeKind.Completed}">
                    <Setter Property="Background" Value="#FFF1F5F9" />
                    <Setter Property="BorderBrush" Value="#FFE2E8F0" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HeldBadgeKind}" Value="{x:Static vm:HeldOrderBadgeKind.Blocked}">
                    <Setter Property="Background" Value="#FFFEF2F2" />
                    <Setter Property="BorderBrush" Value="#FFFECACA" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="HistoryStatusBadgeTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF15803D" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSuspendedOrder}" Value="True">
                    <Setter Property="Foreground" Value="#FFC2410C" />
                </DataTrigger>
                <DataTrigger Binding="{Binding CanContinueInstallmentPayment}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource PosPrimaryBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HeldBadgeKind}" Value="{x:Static vm:HeldOrderBadgeKind.LocalHold}">
                    <Setter Property="Foreground" Value="#FFC2410C" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HeldBadgeKind}" Value="{x:Static vm:HeldOrderBadgeKind.LocalPendingPublish}">
                    <Setter Property="Foreground" Value="#FFC2410C" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HeldBadgeKind}" Value="{x:Static vm:HeldOrderBadgeKind.Published}">
                    <Setter Property="Foreground" Value="#FF15803D" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HeldBadgeKind}" Value="{x:Static vm:HeldOrderBadgeKind.RemotePending}">
                    <Setter Property="Foreground" Value="{StaticResource PosPrimaryBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HeldBadgeKind}" Value="{x:Static vm:HeldOrderBadgeKind.LocalClaimPrepared}">
                    <Setter Property="Foreground" Value="#FF6D28D9" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HeldBadgeKind}" Value="{x:Static vm:HeldOrderBadgeKind.LocalClaimActive}">
                    <Setter Property="Foreground" Value="#FF0F766E" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HeldBadgeKind}" Value="{x:Static vm:HeldOrderBadgeKind.ClaimedByOther}">
                    <Setter Property="Foreground" Value="#FF475569" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HeldBadgeKind}" Value="{x:Static vm:HeldOrderBadgeKind.Completed}">
                    <Setter Property="Foreground" Value="#FF64748B" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HeldBadgeKind}" Value="{x:Static vm:HeldOrderBadgeKind.Blocked}">
                    <Setter Property="Foreground" Value="#FFB91C1C" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="HistoryIconTextButtonStyle" TargetType="Button" BasedOn="{StaticResource PosSecondaryButtonStyle}">
            <Setter Property="Height" Value="34" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource PosPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="#FFE2E8F0" />
        </Style>

        <Style x:Key="HistoryReceiptButtonStyle" TargetType="Button" BasedOn="{StaticResource HistoryIconTextButtonStyle}">
            <Setter Property="Height" Value="40" />
            <Setter Property="MinWidth" Value="104" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Background" Value="#FFEFF6FF" />
            <Setter Property="BorderBrush" Value="#FFBFDBFE" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="HistoryIconButtonStyle" TargetType="Button" BasedOn="{StaticResource PosSecondaryButtonStyle}">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="44" />
            <Setter Property="MinWidth" Value="44" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="{StaticResource PosPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="#FFCBD5E1" />
        </Style>

        <Style x:Key="HistoryPrimaryIconButtonStyle" TargetType="Button" BasedOn="{StaticResource HistoryIconButtonStyle}">
            <Setter Property="BorderBrush" Value="{StaticResource PosPrimaryBrush}" />
        </Style>

        <Style x:Key="HistoryActionCellStyle" TargetType="DataGridCell" BasedOn="{StaticResource HistoryGridCellStyle}">
            <Setter Property="Padding" Value="4,0" />
        </Style>

        <Style x:Key="HistoryMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Height" Value="44" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#FF334155" />
        </Style>

        <Style x:Key="HistoryPreviewLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF64748B" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="HistoryPreviewValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource PosTextBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
    </UserControl.Resources>

    <Grid x:Name="HistoryPageLayout" Background="#FFF5F7FA">
        <Grid x:Name="HistoryWorkspace" Margin="20,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid x:Name="HistoryHeaderRegion" Grid.Row="0" Margin="0,0,0,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Command="{Binding ReturnToPosCommand}"
                            Height="46"
                            Padding="12,0"
                            Margin="0,0,12,0"
                            FontSize="12"
                            Style="{StaticResource PosSecondaryButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ArrowLeft" Width="16" Height="16" Margin="0,0,6,0" />
                            <TextBlock Text="{loc:Loc shell.backToPos}" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>

                    <Border x:Name="HistorySourceNavigation"
                            Grid.Column="1"
                            Height="46"
                            Padding="4"
                            BorderBrush="#FFD7DEE8"
                            BorderThickness="1"
                            CornerRadius="10"
                            Background="#FFE9EEF5">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton GroupName="HistorySource"
                                         IsChecked="{Binding IsLocalSourceSelected, Mode=TwoWay}"
                                         AutomationProperties.Name="{loc:Loc history.source.local}"
                                         Style="{StaticResource HistorySegmentRadioStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Monitor" Width="16" Height="16" Margin="0,0,7,0" />
                                    <TextBlock Text="{loc:Loc history.source.local}" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton GroupName="HistorySource"
                                         IsChecked="{Binding IsOnlineSourceSelected, Mode=TwoWay}"
                                         AutomationProperties.Name="{loc:Loc history.source.online}"
                                         Style="{StaticResource HistorySegmentRadioStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Cloud" Width="16" Height="16" Margin="0,0,7,0" />
                                    <TextBlock Text="{loc:Loc history.source.online}" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton GroupName="HistorySource"
                                         IsChecked="{Binding IsInstallmentSourceSelected, Mode=TwoWay}"
                                         AutomationProperties.Name="{loc:Loc history.source.installments}"
                                         Style="{StaticResource HistorySegmentRadioStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="CalendarClock" Width="16" Height="16" Margin="0,0,7,0" />
                                    <TextBlock Text="{loc:Loc history.source.installments}" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton GroupName="HistorySource"
                                         IsChecked="{Binding IsHeldSourceSelected, Mode=TwoWay}"
                                         AutomationProperties.Name="{Binding HeldOrdersSourceLabel}"
                                         Style="{StaticResource HistorySegmentRadioStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="ClipboardTextClock" Width="16" Height="16" Margin="0,0,7,0" />
                                    <TextBlock Text="{Binding HeldOrdersSourceLabel}" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="3"
                            Height="46"
                            Padding="4"
                            BorderBrush="#FFD7DEE8"
                            BorderThickness="1"
                            CornerRadius="10"
                            Background="#FFE9EEF5"
                            Visibility="{Binding IsHeldScopeSelectorVisible, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="{Binding HeldLocalScopeLabel}"
                                         GroupName="HeldScope"
                                         IsChecked="{Binding IsHeldLocalScopeSelected, Mode=TwoWay}"
                                         Style="{StaticResource HeldScopeSegmentRadioStyle}" />
                            <RadioButton Content="{Binding HeldOtherScopeLabel}"
                                         GroupName="HeldScope"
                                         IsChecked="{Binding IsHeldOtherScopeSelected, Mode=TwoWay}"
                                         Style="{StaticResource HeldScopeSegmentRadioStyle}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Border x:Name="HistoryFilterPanel"
                        Grid.Row="1"
                        Margin="0,10,0,0"
                        Padding="12,10"
                        Style="{StaticResource HistoryPanelStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel x:Name="HistoryDateRangeFilter" Grid.Column="0" Width="286">
                            <TextBlock Text="{loc:Loc history.dateRangeLabel}"
                                       Style="{StaticResource HistoryFilterLabelStyle}" />
                            <Border Height="44"
                                    Padding="2,0"
                                    Background="White"
                                    BorderBrush="#FFD7DEE8"
                                    BorderThickness="1"
                                    CornerRadius="7">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="18" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <DatePicker SelectedDate="{Binding DateFrom, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                SelectedDateFormat="Short"
                                                Height="42"
                                                FontSize="12"
                                                BorderThickness="0"
                                                Background="Transparent"
                                                VerticalContentAlignment="Center"
                                                AutomationProperties.AutomationId="TransactionHistoryDateFrom"
                                                AutomationProperties.Name="{loc:Loc history.dateRangeLabel}"
                                                ToolTip="{loc:Loc history.dateRangeLabel}" />
                                    <TextBlock Grid.Column="1"
                                               Text="-"
                                               Foreground="#FF94A3B8"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                    <DatePicker Grid.Column="2"
                                                SelectedDate="{Binding DateTo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                SelectedDateFormat="Short"
                                                Height="42"
                                                FontSize="12"
                                                BorderThickness="0"
                                                Background="Transparent"
                                                VerticalContentAlignment="Center"
                                                AutomationProperties.AutomationId="TransactionHistoryDateTo"
                                                AutomationProperties.Name="{loc:Loc history.dateRangeLabel}"
                                                ToolTip="{loc:Loc history.dateRangeLabel}" />
                                </Grid>
                            </Border>
                        </StackPanel>

                        <StackPanel x:Name="HistoryTerminalFilter"
                                    Grid.Column="1"
                                    Width="190"
                                    Margin="12,0,0,0"
                                    Visibility="{Binding IsTerminalFilterVisible, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{loc:Loc Terminal}"
                                       Style="{StaticResource HistoryFilterLabelStyle}" />
                            <ComboBox ItemsSource="{Binding TerminalOptions}"
                                      SelectedItem="{Binding SelectedTerminalOption, Mode=TwoWay}"
                                      DisplayMemberPath="Label"
                                      Height="44"
                                      FontSize="12"
                                      ToolTip="{loc:Loc Terminal}" />
                        </StackPanel>

                        <StackPanel x:Name="HistorySearchFilter"
                                    Grid.Column="2"
                                    Margin="12,0,0,0"
                                    MinWidth="220">
                            <TextBlock Text="{loc:Loc history.searchLabel}"
                                       Style="{StaticResource HistoryFilterLabelStyle}" />
                            <Grid>
                                <TextBox x:Name="HistorySearchTextBox"
                                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                         materialDesign:HintAssist.Hint="{Binding SearchHintText}"
                                         Height="44"
                                         FontSize="13"
                                         Padding="38,0,48,0"
                                         Style="{StaticResource PosSearchTextBoxStyle}" />
                                <materialDesign:PackIcon Kind="Magnify"
                                                         Width="18"
                                                         Height="18"
                                                         Foreground="#FF94A3B8"
                                                         Margin="13,0,0,0"
                                                         HorizontalAlignment="Left"
                                                         VerticalAlignment="Center"
                                                         IsHitTestVisible="False" />
                                <Button x:Name="HistorySearchClearButton"
                                        Click="ClearSearchButtonClick"
                                        ToolTip="{loc:Loc Clear}"
                                        AutomationProperties.AutomationId="TransactionHistorySearchClearButton"
                                        AutomationProperties.Name="{loc:Loc Clear}"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Margin="0,0,2,0">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource PosButtonBaseStyle}">
                                            <Setter Property="Width" Value="40" />
                                            <Setter Property="Height" Value="40" />
                                            <Setter Property="MinWidth" Value="40" />
                                            <Setter Property="MinHeight" Value="40" />
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="BorderBrush" Value="Transparent" />
                                            <Setter Property="Foreground" Value="#FF64748B" />
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=HistorySearchTextBox}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Text, ElementName=HistorySearchTextBox}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#FFF1F5F9" />
                                                </Trigger>
                                                <Trigger Property="IsKeyboardFocused" Value="True">
                                                    <Setter Property="Background" Value="#FFE8EEF6" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <materialDesign:PackIcon Kind="CloseCircle"
                                                             Width="17"
                                                             Height="17"
                                                             IsHitTestVisible="False" />
                                </Button>
                            </Grid>
                        </StackPanel>

                        <Button Grid.Column="3"
                                Command="{Binding LoadCommand}"
                                Height="44"
                                MinWidth="104"
                                Padding="16,0"
                                Margin="12,0,0,0"
                                VerticalAlignment="Bottom"
                                FontSize="12"
                                AutomationProperties.Name="{loc:Loc common.load}"
                                Style="{StaticResource PosPrimaryButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Refresh" Width="16" Height="16" Margin="0,0,7,0" />
                                <TextBlock Text="{loc:Loc common.load}" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="1"
                    Style="{StaticResource HistoryPanelStyle}"
                    ClipToBounds="True">
                <DataGrid x:Name="HistoryOrdersGrid"
                          ItemsSource="{Binding Orders}"
                          SelectedItem="{Binding SelectedOrder, Mode=TwoWay}"
                          IsReadOnly="True"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserResizeColumns="False"
                          RowBackground="White"
                          AlternatingRowBackground="#FFFBFDFF"
                          RowStyle="{StaticResource HistoryRowStyle}"
                          CellStyle="{StaticResource HistoryGridCellStyle}"
                          ColumnHeaderStyle="{StaticResource HistoryColumnHeaderStyle}"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          GridLinesVisibility="None"
                          BorderThickness="0"
                          HeadersVisibility="Column"
                          Style="{StaticResource PosCartDataGridStyle}">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn x:Name="ReuploadSelectionColumn"
                                                Header=""
                                                Width="42"
                                                CellStyle="{StaticResource HistoryActionCellStyle}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding Selection.IsSelected}"
                                              IsEnabled="{Binding CanReupload}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn x:Name="OrderSummaryColumn"
                                                Header="{loc:Loc history.orderTime}"
                                                Width="22*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid VerticalAlignment="Center">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0"
                                                   Style="{StaticResource HistoryPrimaryTextStyle}"
                                                   ToolTip="{Binding DisplayOrderId}">
                                            <Run Text="#" />
                                            <Run Text="{Binding DisplayOrderId, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock Grid.Row="1"
                                                   Text="{Binding SoldAtDisplay}"
                                                   ToolTip="{Binding SoldAtDisplay}"
                                                   Margin="0,4,0,0"
                                                   Style="{StaticResource HistorySecondaryTextStyle}" />
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn x:Name="StandardCashierSummaryColumn"
                                                Header="{loc:Loc history.cashierTerminal}"
                                                Width="22*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid VerticalAlignment="Center">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0"
                                                   Text="{Binding CashierName}"
                                                   ToolTip="{Binding CashierName}"
                                                   Style="{StaticResource HistoryPrimaryTextStyle}" />
                                        <DockPanel Grid.Row="1" Margin="0,4,0,0" LastChildFill="True">
                                            <materialDesign:PackIcon Kind="Monitor"
                                                                     DockPanel.Dock="Left"
                                                                     Width="14"
                                                                     Height="14"
                                                                     Margin="0,0,6,0"
                                                                     Foreground="#FF64748B" />
                                            <TextBlock Text="{Binding DeviceCode}"
                                                       ToolTip="{Binding DeviceCode}"
                                                       Style="{StaticResource HistorySecondaryTextStyle}" />
                                        </DockPanel>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn x:Name="InstallmentCustomerSummaryColumn"
                                                Header="{loc:Loc history.customerPhone}"
                                                Width="24*"
                                                Visibility="Collapsed">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid VerticalAlignment="Center">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0"
                                                   Text="{Binding CashierName}"
                                                   ToolTip="{Binding CashierName}"
                                                   Style="{StaticResource HistoryPrimaryTextStyle}" />
                                        <TextBlock Grid.Row="1"
                                                   Margin="0,4,0,0"
                                                   Style="{StaticResource HistorySecondaryTextStyle}">
                                            <Run Text="{Binding CustomerPhone}" />
                                            <Run Text=" · " />
                                            <Run Text="{Binding DeviceCode}" />
                                        </TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn x:Name="StandardAmountSummaryColumn"
                                                Header="{loc:Loc history.amountItems}"
                                                Width="18*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid VerticalAlignment="Center">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0"
                                                   Text="{Binding ActualAmount, StringFormat={}{0:C2}}"
                                                   Style="{StaticResource HistoryPrimaryTextStyle}" />
                                        <DockPanel Grid.Row="1" Margin="0,4,0,0" LastChildFill="True">
                                            <materialDesign:PackIcon Kind="FormatListNumbered"
                                                                     DockPanel.Dock="Left"
                                                                     Width="14"
                                                                     Height="14"
                                                                     Margin="0,0,6,0"
                                                                     Foreground="#FF64748B" />
                                            <TextBlock Style="{StaticResource HistorySecondaryTextStyle}">
                                                <Run Text="{Binding LineCount}" />
                                                <Run Text=" · " />
                                                <Run Text="{Binding PaymentSummary}" />
                                            </TextBlock>
                                        </DockPanel>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn x:Name="InstallmentAmountSummaryColumn"
                                                Header="{loc:Loc history.totalOutstanding}"
                                                Width="26*"
                                                Visibility="Collapsed">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid VerticalAlignment="Center">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0"
                                                   Text="{Binding TotalAmount, StringFormat={}{0:C2}}"
                                                   Style="{StaticResource HistoryPrimaryTextStyle}" />
                                        <TextBlock Grid.Row="1"
                                                   Margin="0,4,0,0"
                                                   Style="{StaticResource HistorySecondaryTextStyle}">
                                            <Run Text="{loc:Loc payment.installment.outstanding}" />
                                            <Run Text=" " />
                                            <Run Text="{Binding ActualAmount, StringFormat={}{0:C2}}" />
                                            <Run Text=" · " />
                                            <Run Text="{loc:Loc history.installment.paid}" />
                                            <Run Text=" " />
                                            <Run Text="{Binding PaymentSummary}" />
                                        </TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn x:Name="StatusSummaryColumn"
                                                Header="{loc:Loc common.status}"
                                                Width="18*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center">
                                        <Border Style="{StaticResource HistoryStatusBadgeBorderStyle}"
                                                MaxWidth="180"
                                                ToolTip="{Binding StatusLabel}">
                                            <TextBlock Text="{Binding StatusLabel}"
                                                       Style="{StaticResource HistoryStatusBadgeTextStyle}" />
                                        </Border>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <TextBlock Text="{Binding ShareStatusLabel}"
                                                       Style="{StaticResource HistorySecondaryTextStyle}" />
                                            <TextBlock Text="..."
                                                       Visibility="{Binding Share.IsBusy, Converter={StaticResource BoolToVis}}"
                                                       Foreground="{StaticResource PosPrimaryBrush}"
                                                       FontWeight="SemiBold"
                                                       Margin="4,0,0,0"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn x:Name="HistoryActionsColumn"
                                                Header=""
                                                Width="216"
                                                CellStyle="{StaticResource HistoryActionCellStyle}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center">
                                        <Button Command="{Binding DataContext.OpenReceiptPreviewCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Margin="0,0,6,0"
                                                ToolTip="{loc:Loc history.viewReceipt}"
                                                AutomationProperties.Name="{loc:Loc history.viewReceipt}"
                                                Style="{StaticResource HistoryReceiptButtonStyle}">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="Receipt" Width="16" Height="16" Margin="0,0,6,0" />
                                                <TextBlock Text="{loc:Loc history.viewReceipt}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>

                                        <Button Command="{Binding DataContext.RecallOrderCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                IsEnabled="{Binding CanRecall}"
                                                Visibility="{Binding CanRecall, Converter={StaticResource BoolToVis}}"
                                                Width="44"
                                                Height="44"
                                                Margin="0,0,6,0"
                                                ToolTip="{loc:Loc suspended.recall}"
                                                AutomationProperties.Name="{loc:Loc suspended.recall}"
                                                Style="{StaticResource HistoryPrimaryIconButtonStyle}">
                                            <materialDesign:PackIcon Kind="ClipboardTextClock" Width="18" Height="18" />
                                        </Button>

                                        <Button Command="{Binding DataContext.ContinueInstallmentPaymentCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                IsEnabled="{Binding CanContinueInstallmentPayment}"
                                                Visibility="{Binding CanContinueInstallmentPayment, Converter={StaticResource BoolToVis}}"
                                                Width="44"
                                                Height="44"
                                                Margin="0,0,6,0"
                                                ToolTip="{loc:Loc history.installment.continuePayment}"
                                                AutomationProperties.Name="{loc:Loc history.installment.continuePayment}"
                                                Style="{StaticResource HistoryPrimaryIconButtonStyle}">
                                            <materialDesign:PackIcon Kind="CalendarClock" Width="18" Height="18" />
                                        </Button>

                                        <Button Click="OpenHistoryRowActionsMenu"
                                                Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                Width="44"
                                                Height="44"
                                                ToolTip="{loc:Loc history.moreActions}"
                                                AutomationProperties.Name="{loc:Loc history.moreActions}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource HistoryIconButtonStyle}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CanShare}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding CanDeleteHeldOrder}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding CanForceRelease}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <Button.ContextMenu>
                                                <ContextMenu DataContext="{Binding PlacementTarget, RelativeSource={RelativeSource Self}}"
                                                             Placement="Bottom"
                                                             StaysOpen="False"
                                                             MinWidth="168"
                                                             Padding="4">
                                                    <MenuItem Header="{Binding Tag.ShareHeldOrderLabel}"
                                                              Command="{Binding Tag.ShareHeldOrderCommand}"
                                                              CommandParameter="{Binding DataContext}">
                                                        <MenuItem.Style>
                                                            <Style TargetType="MenuItem" BasedOn="{StaticResource HistoryMenuItemStyle}">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding DataContext.CanShare}"
                                                                                 Value="True">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </MenuItem.Style>
                                                        <MenuItem.Icon>
                                                            <materialDesign:PackIcon Kind="ShareVariant" Width="17" Height="17" />
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="{Binding Tag.DeleteHeldOrderLabel}"
                                                              Command="{Binding Tag.DeleteHeldOrderCommand}"
                                                              CommandParameter="{Binding DataContext}">
                                                        <MenuItem.Style>
                                                            <Style TargetType="MenuItem" BasedOn="{StaticResource HistoryMenuItemStyle}">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Setter Property="Foreground" Value="{StaticResource PosDangerBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding DataContext.CanDeleteHeldOrder}"
                                                                                 Value="True">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </MenuItem.Style>
                                                        <MenuItem.Icon>
                                                            <materialDesign:PackIcon Kind="DeleteOutline"
                                                                                     Width="17"
                                                                                     Height="17"
                                                                                     Foreground="{StaticResource PosDangerBrush}" />
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="{Binding Tag.ForceReleaseLabel}"
                                                              Command="{Binding Tag.ForceReleaseHeldOrderCommand}"
                                                              CommandParameter="{Binding DataContext}">
                                                        <MenuItem.Style>
                                                            <Style TargetType="MenuItem" BasedOn="{StaticResource HistoryMenuItemStyle}">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding DataContext.CanForceRelease}"
                                                                                 Value="True">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </MenuItem.Style>
                                                        <MenuItem.Icon>
                                                            <materialDesign:PackIcon Kind="LockOpen" Width="17" Height="17" />
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                            <materialDesign:PackIcon Kind="DotsVertical" Width="20" Height="20" />
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <Border Grid.Row="2"
                    Style="{StaticResource HistoryPanelStyle}"
                    Padding="16,12"
                    Margin="0,14,0,0">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Foreground="#FF475569" FontWeight="SemiBold">
                            <Run Text="{loc:Loc history.showingPrefix}" />
                            <Run Text="{Binding Orders.Count, Mode=OneWay}" />
                            <Run Text=" " />
                            <Run Text="{loc:Loc history.transactions}" />
                        </TextBlock>
                        <Separator Width="1" Height="24" Margin="18,0" Background="#FFE2E8F0" />
                        <TextBlock Text="{Binding PreviewOrderId}" Foreground="{StaticResource PosPrimaryBrush}" FontWeight="SemiBold" />
                        <TextBlock Text="  " />
                        <TextBlock Text="{Binding PreviewSoldAt}" Foreground="#FF64748B" />
                    </StackPanel>

                    <Button DockPanel.Dock="Right"
                            Command="{Binding ConfirmInstallmentPickupCommand}"
                            CommandParameter="{Binding SelectedOrder}"
                            Visibility="{Binding IsConfirmInstallmentPickupVisible, Converter={StaticResource BoolToVis}}"
                            Height="40"
                            MinWidth="140"
                            Padding="14,0"
                            Margin="12,0,0,0"
                            Style="{StaticResource PosPrimaryButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CheckCircle" Width="16" Height="16" Foreground="White" Margin="0,0,6,0" />
                            <TextBlock Text="{loc:Loc installment.center.action.confirmPickup}" Foreground="White" FontWeight="Bold" />
                        </StackPanel>
                    </Button>

                    <Button DockPanel.Dock="Right"
                            Command="{Binding ReuploadSelectedCommand}"
                            Content="{loc:Loc history.reuploadSelected}"
                            Visibility="{Binding IsLocalSourceSelected, Converter={StaticResource BoolToVis}}"
                            Height="40"
                            Padding="14,0"
                            Margin="12,0,0,0"
                            Style="{StaticResource PosPrimaryButtonStyle}" />

                    <Button DockPanel.Dock="Right"
                            Command="{Binding ReuploadDateRangeCommand}"
                            ToolTip="{loc:Loc history.reuploadDateRangeTooltip}"
                            Visibility="{Binding IsLocalSourceSelected, Converter={StaticResource BoolToVis}}"
                            Height="40"
                            Padding="14,0"
                            Margin="12,0,0,0"
                            Style="{StaticResource HistoryIconTextButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Upload" Width="16" Height="16" Margin="0,0,6,0" />
                            <TextBlock Text="{loc:Loc history.reuploadDateRange}" />
                        </StackPanel>
                    </Button>

                    <Button DockPanel.Dock="Right"
                            Command="{Binding SelectAllReuploadableCommand}"
                            Content="{loc:Loc shell.sync.selectAll}"
                            Visibility="{Binding IsLocalSourceSelected, Converter={StaticResource BoolToVis}}"
                            Height="40"
                            Padding="14,0"
                            Margin="12,0,0,0"
                            Style="{StaticResource HistoryIconTextButtonStyle}" />

                    <Button DockPanel.Dock="Right"
                            Command="{Binding ForceReleaseHeldOrderCommand}"
                            CommandParameter="{Binding SelectedOrder}"
                            Visibility="{Binding IsForceReleaseVisible, Converter={StaticResource BoolToVis}}"
                            Height="40"
                            Padding="14,0"
                            Margin="12,0,0,0"
                            Style="{StaticResource HistoryIconTextButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="LockOpen" Width="16" Height="16" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding ForceReleaseLabel}" />
                        </StackPanel>
                    </Button>

                    <ProgressBar Width="64"
                                 Height="4"
                                 IsIndeterminate="True"
                                 VerticalAlignment="Center"
                                 Margin="12,0,0,0"
                                 Visibility="{Binding IsHeldRemoteRefreshVisible, Converter={StaticResource BoolToVis}}" />

                    <TextBlock Text="{Binding HeldOrdersRemoteStatusMessage}"
                               Foreground="#FFB45309"
                               VerticalAlignment="Center"
                               TextAlignment="Right"
                               TextWrapping="Wrap"
                               Margin="12,0,0,0"
                               Visibility="{Binding IsHeldRemoteErrorVisible, Converter={StaticResource BoolToVis}}" />

                    <TextBlock Text="{Binding StatusMessage}"
                               Foreground="{StaticResource PosDangerBrush}"
                               VerticalAlignment="Center"
                               TextAlignment="Right"
                               TextWrapping="Wrap" />
                </DockPanel>
            </Border>
        </Grid>

        <Grid x:Name="ReceiptPreviewOverlay"
              Panel.ZIndex="100"
              Background="#660F172A"
              FocusManager.IsFocusScope="True"
              FocusManager.FocusedElement="{Binding ElementName=ReceiptPreviewCloseButton}"
              KeyboardNavigation.TabNavigation="Cycle"
              AutomationProperties.AutomationId="TransactionHistoryReceiptPreviewOverlay"
              AutomationProperties.Name="{loc:Loc success.receiptPreview}"
              Visibility="{Binding IsReceiptPreviewOpen, Converter={StaticResource BoolToVis}}">
            <Grid.InputBindings>
                <KeyBinding Key="Escape" Command="{Binding CloseReceiptPreviewCommand}" />
            </Grid.InputBindings>

            <Border x:Name="ReceiptPreviewDialog"
                    Width="680"
                    MaxHeight="820"
                    Margin="28"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Stretch"
                    Background="White"
                    BorderBrush="#FFE2E8F0"
                    BorderThickness="1"
                    CornerRadius="12"
                    AutomationProperties.AutomationId="TransactionHistoryReceiptPreviewDialog">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.24" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Padding="22,18"
                            BorderBrush="#FFE2E8F0"
                            BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="Receipt"
                                                         Width="22"
                                                         Height="22"
                                                         Margin="0,0,10,0"
                                                         Foreground="{StaticResource PosPrimaryBrush}" />
                                <TextBlock Text="{loc:Loc success.receiptPreview}"
                                           FontSize="20"
                                           FontWeight="Black"
                                           Foreground="{StaticResource PosTextBrush}" />
                                <Border Margin="10,0,0,0"
                                        Padding="8,3"
                                        CornerRadius="6"
                                        Background="#FFE7F7EF"
                                        BorderBrush="#FFBBF7D0"
                                        BorderThickness="1">
                                    <TextBlock Text="{Binding SelectedOrder.StatusLabel}"
                                               Foreground="#FF15803D"
                                               FontSize="12"
                                               FontWeight="SemiBold" />
                                </Border>
                            </StackPanel>

                            <TextBlock Grid.Column="1"
                                       Text="{Binding PreviewTotal, StringFormat={}{0:C2}}"
                                       FontSize="26"
                                       FontWeight="Black"
                                       Foreground="{StaticResource PosTextBrush}"
                                       VerticalAlignment="Center"
                                       Margin="20,0" />

                            <Button x:Name="ReceiptPreviewCloseButton"
                                    Grid.Column="2"
                                    Command="{Binding CloseReceiptPreviewCommand}"
                                    Width="40"
                                    Height="40"
                                    MinWidth="40"
                                    Padding="0"
                                    ToolTip="{loc:Loc history.closeReceiptPreview}"
                                    AutomationProperties.AutomationId="TransactionHistoryReceiptPreviewCloseButton"
                                    AutomationProperties.Name="{loc:Loc history.closeReceiptPreview}"
                                    Style="{StaticResource HistoryIconButtonStyle}">
                                <materialDesign:PackIcon Kind="Close" Width="19" Height="19" />
                            </Button>

                            <Grid Grid.Row="1" Grid.ColumnSpan="3" Margin="32,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{loc:Loc OrderNumber}" Style="{StaticResource HistoryPreviewLabelStyle}" />
                                    <TextBlock Text="{Binding PreviewOrderId}" Style="{StaticResource HistoryPreviewValueStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                    <TextBlock Text="{loc:Loc Time}" Style="{StaticResource HistoryPreviewLabelStyle}" TextAlignment="Right" />
                                    <TextBlock Text="{Binding PreviewSoldAt}" Style="{StaticResource HistoryPreviewValueStyle}" TextAlignment="Right" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1" Background="#FFF8FAFC">
                        <ScrollViewer Margin="24,18"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                            <Border Width="430"
                                    Padding="24"
                                    HorizontalAlignment="Center"
                                    Background="#FFFFFEFA"
                                    BorderBrush="#FFE2E8F0"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.10" />
                                </Border.Effect>
                                <ItemsControl ItemsSource="{Binding ReceiptPreviewRows}"
                                              ItemTemplate="{StaticResource ReceiptPreviewRowTemplate}" />
                            </Border>
                        </ScrollViewer>

                        <Border Background="#EFFFFFFF"
                                Visibility="{Binding IsReceiptPreviewLoading, Converter={StaticResource BoolToVis}}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ProgressBar Width="180" Height="5" IsIndeterminate="True" />
                                <TextBlock Text="{loc:Loc history.receiptLoading}"
                                           Margin="0,14,0,0"
                                           Foreground="#FF64748B"
                                           FontSize="13"
                                           FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Grid.Row="2"
                            Padding="18"
                            Background="White"
                            BorderBrush="#FFE2E8F0"
                            BorderThickness="0,1,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Command="{Binding CloseReceiptPreviewCommand}"
                                    Content="{loc:Loc history.closeReceiptPreview}"
                                    Height="44"
                                    MinWidth="108"
                                    Margin="0,0,12,0"
                                    AutomationProperties.Name="{loc:Loc history.closeReceiptPreview}"
                                    Style="{StaticResource PosSecondaryButtonStyle}" />
                            <Button Command="{Binding ReprintCommand}"
                                    Height="44"
                                    MinWidth="148"
                                    Visibility="{Binding IsReprintVisible, Converter={StaticResource BoolToVis}}"
                                    AutomationProperties.Name="{loc:Loc history.reprint}"
                                    Style="{StaticResource PosPrimaryButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Printer" Width="17" Height="17" Foreground="White" Margin="0,0,7,0" />
                                    <TextBlock Text="{loc:Loc history.reprint}" Foreground="White" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Grid Panel.ZIndex="200"
              Background="#66000000"
              Visibility="{Binding IsForceReleaseReasonPromptOpen, Converter={StaticResource BoolToVis}}">
            <Border Width="440"
                    Padding="24"
                    Background="White"
                    BorderBrush="#FFE2E8F0"
                    BorderThickness="1"
                    CornerRadius="10">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.2" />
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="{Binding ForceReleaseLabel}"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="{StaticResource PosTextBrush}"
                               Margin="0,0,0,4" />
                    <TextBlock Text="{Binding ForceReleaseReasonLabel}"
                               Foreground="#FF64748B"
                               FontSize="12"
                               Margin="0,0,0,6" />
                    <TextBox Text="{Binding ForceReleaseReason, UpdateSourceTrigger=PropertyChanged}"
                             Height="44"
                             FontSize="13"
                             Padding="10,0"
                             VerticalContentAlignment="Center"
                             materialDesign:HintAssist.Hint="{Binding ForceReleaseReasonLabel}"
                             Style="{StaticResource PosSearchTextBoxStyle}" />
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,18,0,0">
                        <Button Command="{Binding CancelForceReleaseCommand}"
                                Content="{Binding ForceReleaseCancelLabel}"
                                Height="38"
                                MinWidth="92"
                                Margin="0,0,10,0"
                                Style="{StaticResource PosSecondaryButtonStyle}" />
                        <Button Command="{Binding ConfirmForceReleaseCommand}"
                                Content="{Binding ForceReleaseConfirmLabel}"
                                Height="38"
                                MinWidth="92"
