{
  "cli": {
    "version": "21.3.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "EXPO_PUBLIC_HBPOS_BUILD_PROFILE": "development"
      }
    },
    "development-simulator": {
      "extends": "development",
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "EXPO_PUBLIC_HBPOS_BUILD_PROFILE": "preview"
      }
    },
    "production": {
      "distribution": "store",
      "channel": "pos-ipad-production",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_HBPOS_BUILD_PROFILE": "production"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
