EXPO_PUBLIC_HBPOS_API_URL=https://example.invalid
# 可选：签名构建允许在设置页切换的备用 origin，逗号分隔；持久化设置不能扩张此列表。
EXPO_PUBLIC_HBPOS_TRUSTED_API_ORIGINS=https://backup.example.invalid
EXPO_PUBLIC_HBPOS_CARD_PROVIDER=square
EXPO_PUBLIC_HBPOS_SQUARE_ENVIRONMENT=Sandbox
EXPO_PUBLIC_HBPOS_SQUARE_DEVICE_ID=
EXPO_PUBLIC_HBPOS_SQUARE_LOCATION_ID=
EXPO_PUBLIC_HBPOS_LINKLY_ENVIRONMENT=Sandbox
EXPO_PUBLIC_HBPOS_VOUCHER_ENABLED=false
# 中心程序日志：write key 为可撤销、仅写且受限流保护的公开安装包凭据，不提交真实值。
EXPO_PUBLIC_HBPOS_LOG_CENTER_ENABLED=false
EXPO_PUBLIC_HBPOS_LOG_CENTER_INGEST_URL=https://example.invalid/api/system/logs/ingest
EXPO_PUBLIC_HBPOS_LOG_CENTER_WRITE_KEY=
EXPO_PUBLIC_HBPOS_LOG_CENTER_ENVIRONMENT=development
# DSN 是 Sentry 客户端公开端点；真实项目值只在 EAS 环境中配置。
EXPO_PUBLIC_HBPOS_SENTRY_DSN=
EXPO_PUBLIC_HBPOS_SENTRY_ENVIRONMENT=development
SENTRY_ORG=
SENTRY_PROJECT=hb-pos-ipad
SENTRY_URL=https://sentry.io/
# SENTRY_AUTH_TOKEN 必须作为 EAS sensitive 环境变量提供，禁止写入仓库或 EXPO_PUBLIC 变量。
