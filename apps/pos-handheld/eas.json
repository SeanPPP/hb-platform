{
  "cli": {
    "version": ">= 21.3.0",
    "appVersionSource": "remote",
    "requireCommit": true
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "pos-handheld-development",
      "env": {
        "EXPO_PUBLIC_HBPOS_BUILD_PROFILE": "development"
      }
    },
    "development-simulator": {
      "extends": "development",
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "pos-handheld-preview",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_HBPOS_BUILD_PROFILE": "preview"
      }
    },
    "production": {
      "distribution": "store",
      "channel": "pos-handheld-production",
      "environment": "production",
      "autoIncrement": true,
      "ios": {
        "image": "macos-sequoia-15.6-xcode-26.0"
      },
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_HBPOS_BUILD_PROFILE": "production"
      }
    },
    "android-internal": {
      "distribution": "internal",
      "channel": "pos-handheld-production",
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_HBPOS_BUILD_PROFILE": "production"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6802182045"
      }
    }
  }
}
