{
  "manifest_version": 3,
  "name": "HB Supplier Order",
  "version": "__VERSION__",
  "description": "Hot Bargain supplier order purchase-cycle assistant for supplier list pages.",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "sidePanel", "scripting"],
  "host_permissions": ["__API_ORIGIN__/*"],
  "optional_host_permissions": [
    "https://*/*",
    "http://txkorders.inzantsales.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "action": {
    "default_title": "HB Supplier Order",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["__WEB_ORIGIN__/*"],
      "js": ["content/shop-bridge.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["lib/*", "config.js"],
      "matches": ["https://*/*", "http://txkorders.inzantsales.com/*"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
